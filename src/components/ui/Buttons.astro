---
export interface Props {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: '_self' | '_blank';
  rel?: string;
}

const {
  text,
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
} = Astro.props;

const computedRel =
  target === '_blank' ? (rel ?? 'noopener noreferrer') : rel;

const variants = {
  /**
   * Light: 기존 유지(채움 + 흰 글씨)
   * Dark : 기존 lux 스타일 유지 + ✅ 텍스트는 밝게(white) 고정
   */
  primary:
    'bg-highlightBlue text-white hover:bg-highlightBlue/90 ' +
    'dark:bg-primary dark:text-white dark:hover:bg-primary/95 ' +
    'dark:border dark:border-white/15 ' +
    'dark:ring-1 dark:ring-white/10 ' +
    'dark:shadow-[0_10px_30px_-18px_rgba(0,0,0,0.65)] ' +
    'dark:hover:border-white/22 dark:hover:ring-white/14',

  secondary:
    'bg-secondary text-white hover:bg-secondary/90 ' +
    'dark:bg-secondary dark:text-white dark:hover:bg-secondary/90',

  outline:
    'bg-transparent border border-primary text-primary hover:bg-primary/10 ' +
    'dark:border-primary dark:text-primary dark:hover:bg-primary/20',
};

const sizes = {
  sm: 'text-sm py-2 px-4',
  md: 'text-body py-3 px-6',
  lg: 'text-lg py-4 px-8',
};
---

<a
  href={href}
  target={target}
  rel={computedRel}
  class:list={[
    // ✅ 텍스트가 오버레이에 가려지지 않도록 relative + overflow + isolate
    'relative isolate overflow-hidden inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 transform hover:scale-104 hover:shadow-button focus:outline-none focus:ring-2 focus:ring-primary/50 focus-visible:ring-2 focus-visible:ring-primary/50',

    sizes[size],

    // caller class first
    className,

    // variant last (wins)
    variants[variant],
  ]}
  data-aos="fade-up"
>
  <!-- ✅ 텍스트는 항상 최상단 레이어 -->
  <span class="relative z-10">{text}</span>
  <span class="relative z-10"><slot /></span>

  <!-- ✅ 광택 오버레이는 텍스트 아래 레이어로 고정 -->
  <span
    class="pointer-events-none absolute inset-0 z-0 opacity-0 transition-opacity duration-300 dark:opacity-100"
    style="background: linear-gradient(180deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.06) 28%, rgba(255,255,255,0) 60%);"
  ></span>
</a>

<style>
  .hover\:scale-104:hover {
    transform: scale(1.04);
  }
</style>
