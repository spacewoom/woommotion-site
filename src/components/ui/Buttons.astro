---
export interface Props {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: '_self' | '_blank';
  rel?: string;
}

const {
  text,
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
} = Astro.props;

const computedRel = target === '_blank'
  ? (rel ?? 'noopener noreferrer')
  : rel;

const variants = {
  /**
   * ✅ 항상 배경과 구분되게:
   * - Light: highlightBlue(진한 톤)로 채움 + white 텍스트
   * - Dark : primary(밝은 톤)로 채움 + dark 배경에 대비되는 텍스트
   */
  primary:
    'bg-highlightBlue text-white hover:bg-highlightBlue/90 ' +
    'dark:bg-primary dark:text-neutral-dark dark:hover:bg-primary/90',

  /**
   * secondary는 기존 의도를 최대한 유지하되, dark에서는 highlightBlue로 확실히 분리
   */
  secondary:
    'bg-secondary text-white hover:bg-secondary/90 ' +
    'dark:bg-highlightBlue dark:text-white dark:hover:bg-highlightBlue/90',

  /**
   * outline은 그대로 (배경과의 대비는 border/text로 확보)
   */
  outline:
    'bg-transparent border border-primary text-primary hover:bg-primary/10 ' +
    'dark:hover:bg-primary/15',
};

const sizes = {
  sm: 'text-sm py-2 px-4',
  md: 'text-body py-3 px-6',
  lg: 'text-lg py-4 px-8',
};
---

<a
  href={href}
  target={target}
  rel={computedRel}
  class:list={[
    'inline-flex items-center justify-center rounded-lg font-medium transition-all duration-300 transform hover:scale-104 hover:shadow-button focus:outline-none focus:ring-2 focus:ring-primary/50 focus-visible:ring-2 focus-visible:ring-primary/50',
    variants[variant],
    sizes[size],
    className
  ]}
  data-aos="fade-up"
>
  {text}
  <slot />
</a>

<style>
  .hover\:scale-104:hover {
    transform: scale(1.04);
  }
</style>
