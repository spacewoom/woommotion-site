---
import ThemeToggle from '../ui/ThemeToggle.astro';
---
<header class="fixed top-0 left-0 w-full z-50 bg-white/80 dark:bg-neutral-dark/80 backdrop-blur-md border-b border-gray-100 dark:border-gray-800">
  <div class="max-w-container mx-auto px-6 h-16 flex items-center justify-between">

    <!-- LEFT : Logo -->
    <a href="/#home" class="flex items-center py-1" aria-label="WOOM Homepage">
      <!-- Light mode -->
      <img
        src="/images/logo.svg"
        alt="WOOM"
        class="h-8 w-auto dark:hidden"
        loading="eager"
        decoding="async"
      />
      <!-- Dark mode -->
      <img
        src="/images/logo_white.svg"
        alt="WOOM"
        class="h-8 w-auto hidden dark:block"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- CENTER : Navigation -->
    <nav class="hidden md:flex items-center space-x-10">
      <a href="#home" class="nav-link">home</a>
      <a href="#works" class="nav-link">works</a>
      <a href="#services" class="nav-link">services</a>
      <a href="#contact" class="nav-link">contact</a>
    </nav>

    <!-- RIGHT : Theme toggle -->
    <div class="flex items-center gap-4">
      <ThemeToggle />
    </div>

  </div>
</header>

<style>
  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: #1f2937; /* gray-800 */
    transition: color 0.2s ease;
  }

  .dark .nav-link {
    color: #e5e7eb; /* gray-200 */
  }

  .nav-link:hover {
    color: #2563eb; /* primary */
  }
</style>
