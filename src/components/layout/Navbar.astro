---
import ThemeToggle from "../ui/ThemeToggle.astro";
const lang = Astro.currentLocale;
const pathname = Astro.url?.pathname ?? "/";
---

<header id="navbar" class="fixed top-0 w-full bg-white/90 dark:bg-neutral-900/90 backdrop-blur-sm z-50 transition-all duration-300">
  <div class="max-w-container mx-auto px-6 py-4 flex items-center justify-between">
    <!-- LEFT: Logo (light/dark switch by CSS) -->
    <a href="/#home" class="flex items-center gap-3" aria-label="Homepage">
      <img
        src="/images/logo.svg"
        alt="WOOM logo"
        width="130"
        height="48"
        class="h-8 w-auto dark:hidden"
        loading="eager"
        decoding="async"
      />
      <img
        src="/images/logo_white.svg"
        alt="WOOM logo (white)"
        width="130"
        height="48"
        class="hidden h-8 w-auto dark:block"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- RIGHT: Nav -->
    <nav class="flex items-center gap-8">
      <a href="/#home" class={`font-medium hover:opacity-80 ${pathname === "/" ? "text-primary" : "text-neutral-900 dark:text-neutral-100"}`}>home</a>
      <a href="/works" class="font-medium text-neutral-900 dark:text-neutral-100 hover:opacity-80">works</a>
      <a href="/#services" class="font-medium text-neutral-900 dark:text-neutral-100 hover:opacity-80">services</a>
      <a href="/#contact" class="font-medium text-neutral-900 dark:text-neutral-100 hover:opacity-80">contact</a>

      <ThemeToggle />
    </nav>
  </div>
</header>
