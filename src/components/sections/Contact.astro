---
import Button from '../ui/Buttons.astro';
import * as i18n from '../../utils/i18n';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;

// ✅ locale 미정의 에러 방지
const locale = lang ?? 'en';

// ✅ t가 함수가 아닐 때도 빌드가 안 깨지도록 안전 래퍼
const translate = (key: string) => {
  const maybeT = (i18n as any)?.t ?? (i18n as any)?.default;
  return typeof maybeT === 'function' ? maybeT(key, locale) : key;
};

// ✅ \n / \\n 모두 줄바꿈으로 처리 (브라우저에서 확실히 보이게 <br/>로 렌더)
const toLines = (value: unknown) => String(value ?? '').replace(/\\n/g, '\n').split(/\r?\n/);

// ✅ 카카오톡 상담 링크 (네가 쓰는 오픈채팅 URL로 유지/교체)
const KAKAO_OPENCHAT_URL = 'https://open.kakao.com/o/sU2CPZkg';
---

<section class="py-16 md:py-24 bg-secondary dark:bg-neutral-dark text-white">
  <div class="max-w-container mx-auto px-6">
    <div class="bg-white/5 border border-white/10 rounded-3xl p-10 md:p-14 text-center backdrop-blur-sm" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-white mb-4">
        {translate('footerCTA.title')}
      </h2>

      <p class="text-white/70 mt-3 max-w-2xl mx-auto">
        {toLines(translate('footerCTA.subtitle')).map((line, idx, arr) => (
          <>
            {line}
            {idx < arr.length - 1 && <br />}
          </>
        ))}
      </p>

      <div class="mt-10 flex justify-center">
        <Button
          text={translate('footerCTA.buttonText')}
          href={KAKAO_OPENCHAT_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
        />
      </div>
    </div>
  </div>
</section>
