---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

// Ensure line breaks work whether JSON contains \n or actual newlines
const formatMultiline = (value = '') => String(value).replace(/\\n/g, '\n');
---

<section id="contact" class="py-16 md:py-24 bg-secondary dark:bg-neutral-dark text-white">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-white mb-4">
        {t('contact.title', lang)}
      </h2>
      <p class="text-white/70 mt-2 max-w-xl mx-auto whitespace-pre-line">
        {formatMultiline(t('contact.subtitle', lang))}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Basic -->
      <div
        class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors"
        data-aos="fade-up"
        data-aos-delay="0"
      >
        <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mb-6 mx-auto">
          <img src="/contact/one.svg" alt="" class="w-7 h-7 dark:invert" loading="lazy" />
        </div>

        <h3 class="text-xl font-semibold mb-3 mt-6 text-center">
          {t('contact.emailTitle', lang)}
        </h3>

        <p class="text-white/70 mb-6 whitespace-pre-line text-left">
          {formatMultiline(t('contact.emailText', lang))}
        </p>

        <div class="text-primary font-medium text-left whitespace-pre-line">
          {formatMultiline(t('contact.emailButtonText', lang))}
        </div>
      </div>

      <!-- Standard -->
      <div
        class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mb-6 mx-auto">
          <img src="/contact/two.svg" alt="" class="w-7 h-7 dark:invert" loading="lazy" />
        </div>

        <h3 class="text-xl font-semibold mb-3 mt-6 text-center">
          {t('contact.phoneTitle', lang)}
        </h3>

        <p class="text-white/70 mb-6 whitespace-pre-line text-left">
          {formatMultiline(t('contact.phoneText', lang))}
        </p>

        <div class="text-primary font-medium text-left whitespace-pre-line">
          {formatMultiline(t('contact.phoneButtonText', lang))}
        </div>
      </div>

      <!-- Premium -->
      <div
        class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mb-6 mx-auto">
          <img src="/contact/three.svg" alt="" class="w-7 h-7 dark:invert" loading="lazy" />
        </div>

        <h3 class="text-xl font-semibold mb-3 mt-6 text-center">
          {t('contact.linkedinTitle', lang)}
        </h3>

        <p class="text-white/70 mb-6 whitespace-pre-line text-left">
          {formatMultiline(t('contact.linkedinText', lang))}
        </p>

        <div class="text-primary font-medium text-left whitespace-pre-line">
          {formatMultiline(t('contact.linkedinButtonText', lang))}
        </div>
      </div>
    </div>
  </div>
</section>
