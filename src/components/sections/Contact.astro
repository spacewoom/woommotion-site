---
interface Props {
  lang: string;
  t: (key: string, lang: string) => string;
}

const { lang, t } = Astro.props;

// HTML은 기본적으로 개행을 무시하므로,
// 텍스트를 escape한 다음 \n(실개행/리터럴 모두)을 <br />로 치환해서 확실히 줄바꿈 처리
const escapeHtml = (str = "") =>
  String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

// Ensure both literal "\\n" and real newlines render as line breaks
const nl2br = (value = "") => {
  const normalized = String(value).replace(/\\n/g, "\n");
  return escapeHtml(normalized).replace(/\r?\n/g, "<br />");
};

const contacts = [
  {
    titleKey: "contact.emailTitle",
    textKey: "contact.emailText",
    buttonKey: "contact.emailButtonText",
    icon: "/contact/one.svg",
  },
  {
    titleKey: "contact.phoneTitle",
    textKey: "contact.phoneText",
    buttonKey: "contact.phoneButtonText",
    icon: "/contact/two.svg",
  },
  {
    titleKey: "contact.linkedinTitle",
    textKey: "contact.linkedinText",
    buttonKey: "contact.linkedinButtonText",
    icon: "/contact/three.svg",
  },
];
---

<section id="contact" class="py-20 bg-black text-white">
  <div class="container mx-auto px-4">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="text-4xl font-bold">{t("contact.title", lang)}</h2>
      <p
        class="text-white/70 mt-2 max-w-[726px] mx-auto whitespace-pre-line"
        set:html={nl2br(t("contact.subtitle", lang))}
      ></p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {contacts.map((c) => (
        <div
          class="bg-white/5 border border-white/10 rounded-2xl p-6 flex flex-col justify-between hover:bg-white/10 transition"
          data-aos="fade-up"
        >
          <div>
            <div class="flex items-center gap-3 mb-3">
              <img src={c.icon} alt="" class="w-6 h-6" loading="lazy" />
              <h3 class="text-xl font-semibold">{t(c.titleKey, lang)}</h3>
            </div>

            <p
              class="text-white/70 mb-6 whitespace-pre-line text-left"
              set:html={nl2br(t(c.textKey, lang))}
            ></p>
          </div>

          <div
            class="text-sm text-white/70 text-left whitespace-pre-line"
            set:html={nl2br(t(c.buttonKey, lang))}
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>
