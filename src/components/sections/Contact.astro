---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

// Normalize line breaks for any of these cases:
// 1) actual newline "\n"
// 2) literal backslash-n "\\n"
// 3) Windows newline "\r\n"
const normalizeBreaks = (value = '') =>
  String(value).replace(/\r\n/g, '\n').replace(/\\n/g, '\n');

const toLines = (value = '') => normalizeBreaks(value).split('\n');

// Pre-split once (stable + minimal runtime work)
const subtitleLines = toLines(t('contact.subtitle', lang));

const emailTextLines = toLines(t('contact.emailText', lang));
const phoneTextLines = toLines(t('contact.phoneText', lang));
const linkedinTextLines = toLines(t('contact.linkedinText', lang));

const emailButtonLines = toLines(t('contact.emailButtonText', lang));
const phoneButtonLines = toLines(t('contact.phoneButtonText', lang));
const linkedinButtonLines = toLines(t('contact.linkedinButtonText', lang));
---

<section id="contact" class="py-16 md:py-24 bg-secondary dark:bg-neutral-dark text-white">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-white mb-4">
        {t('contact.title', lang)}
      </h2>

      <!-- widen subtitle area (~ +80px) -->
      <p class="text-white/70 mt-2 max-w-2xl mx-auto">
        {subtitleLines.map((line, i) => (
          <>
            {line}
            {i < subtitleLines.length - 1 && <br />}
          </>
        ))}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Basic -->
      <div
        class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors"
        data-aos="fade-up"
        data-aos-delay="0"
      >
        <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mb-6 mx-auto">
          <img src="/contact/one.svg" alt="" class="w-7 h-7" loading="lazy" />
        </div>

        <h3 class="text-xl font-semibold mb-3 mt-6 text-center">
          {t('contact.emailTitle', lang)}
        </h3>

        <p class="text-white/70 mb-6 text-left">
          {emailTextLines.map((line, i) => (
            <>
              {line}
              {i < emailTextLines.length - 1 && <br />}
            </>
          ))}
        </p>

        <div class="text-primary font-medium text-left">
          {emailButtonLines.map((line, i) => (
            <>
              {line}
              {i < emailButtonLines.length - 1 && <br />}
            </>
          ))}
        </div>
      </div>

      <!-- Standard -->
      <div
        class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mb-6 mx-auto">
          <img src="/contact/two.svg" alt="" class="w-7 h-7" loading="lazy" />
        </div>

        <h3 class="text-xl font-semibold mb-3 mt-6 text-center">
          {t('contact.phoneTitle', lang)}
        </h3>

        <p class="text-white/70 mb-6 text-left">
          {phoneTextLines.map((line, i) => (
            <>
              {line}
              {i < phoneTextLines.length - 1 && <br />}
            </>
          ))}
        </p>

        <div class="text-primary font-medium text-left">
          {phoneButtonLines.map((line, i) => (
            <>
              {line}
              {i < phoneButtonLines.length - 1 && <br />}
            </>
          ))}
        </div>
      </div>

      <!-- Premium -->
      <div
        class="bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-sm hover:bg-white/10 transition-colors"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mb-6 mx-auto">
          <img src="/contact/three.svg" alt="" class="w-7 h-7" loading="lazy" />
        </div>

        <h3 class="text-xl font-semibold mb-3 mt-6 text-center">
          {t('contact.linkedinTitle', lang)}
        </h3>

        <p class="text-white/70 mb-6 text-left">
          {linkedinTextLines.map((line, i) => (
            <>
              {line}
              {i < linkedinTextLines.length - 1 && <br />}
            </>
          ))}
        </p>

        <div class="text-primary font-medium text-left">
          {linkedinButtonLines.map((line, i) => (
            <>
              {line}
              {i < linkedinButtonLines.length - 1 && <br />}
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
