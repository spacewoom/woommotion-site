---
import { Image } from 'astro:assets';

import heroBg from '../../assets/Hero_BG.png';
import logoCatchphrase from '../../assets/Logo_Catchphrase.svg';
import logoCatchphraseWh from '../../assets/Logo_Catchphrase_Wh.png';

const KAKAO_CHANNEL_HOME = "https://pf.kakao.com/_pSgdn";
const KAKAO_DIRECT_CHAT = "https://pf.kakao.com/_pSgdn/chat";

const BRAND_VIDEO_ID = "7oYcwL0jLuk";
const YT_EMBED = `https://www.youtube.com/embed/${BRAND_VIDEO_ID}?autoplay=1&mute=1&controls=1&rel=0&playsinline=1&loop=1&playlist=${BRAND_VIDEO_ID}`;
---

<section id="home" class="relative pt-[72px] md:pt-[80px] pb-16 md:pb-24">
  <!-- ✅ BG 적용 영역: 메뉴바 아래부터 좌/우 끝까지 -->
  <div class="relative w-full overflow-hidden" style={`--hero-bg:url(${heroBg.src});`}>
    <!-- ✅ BG 이미지: 라이트 93%, 다크 90% -->
    <div
      class="absolute inset-0 -z-10 bg-center bg-cover opacity-[0.93] dark:opacity-[0.90]"
      style="background-image: var(--hero-bg);"
    ></div>

    <!-- (선택) 오버레이: 가독성용 -->
    <div class="absolute inset-0 -z-10 bg-white/15 dark:bg-black/25"></div>

    <!-- ✅ BG 영역 높이: 조금 더 크게 + 상단 공간 확보 -->
    <div class="relative h-[clamp(580px,78vh,980px)]">
      <div class="max-w-container mx-auto px-6 h-full">
        <!-- ✅ 상단 여백을 늘려 로고가 더 아래에서 시작 -->
        <div class="h-full flex flex-col items-center text-center pt-14 md:pt-20 pb-10">
          
          <!-- ✅ 로고: 카피 폭에 맞춰 제한 (비율 유지) -->
          <div class="w-full max-w-[680px]">
            <!-- Light mode -->
            <Image
              src={logoCatchphrase}
              alt="WOOM Logo Catchphrase"
              class="w-full h-auto dark:hidden"
              loading="eager"
            />

            <!-- Dark mode -->
            <Image
              src={logoCatchphraseWh}
              alt="WOOM Logo Catchphrase (White)"
              class="w-full h-auto hidden dark:block"
              loading="eager"
            />
          </div>

          <!-- ✅ 카피: 간격 확대 -->
          <div class="mt-8 w-full max-w-[680px] space-y-5">
            <p class="text-base sm:text-lg md:text-xl text-secondary dark:text-white">
              ‘움’은 모션그래픽을 기반으로 브랜드 메시지를 설득력 있게 전달합니다.
            </p>
            <p class="text-sm sm:text-base md:text-lg text-secondary/70 dark:text-white/80">
              ‘Woom’ brings brand messages to life with compelling motion graphics.
            </p>
          </div>

          <!-- ✅ 버튼: 라이트(#003124) / 다크(#e4f5f0) outline only -->
          <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="/projects"
              class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-8
                     border border-[#003124] text-[#003124]
                     hover:bg-[#003124]/10 bg-transparent
                     dark:border-[#e4f5f0] dark:text-[#e4f5f0]
                     dark:hover:bg-[#e4f5f0]/10"
            >
              Works 보기
            </a>

            <a
              href={KAKAO_DIRECT_CHAT}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-8
                     border border-[#003124] text-[#003124]
                     hover:bg-[#003124]/10 bg-transparent
                     dark:border-[#e4f5f0] dark:text-[#e4f5f0]
                     dark:hover:bg-[#e4f5f0]/10"
              aria-label="KakaoTalk 문의 (새 탭)"
            >
              KakaoTalk 문의
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- ✅ 비디오 영역: BG 밖 -->
  <div class="max-w-container mx-auto px-6">
    <div class="mt-10 md:mt-12 mx-auto w-full max-w-[1100px]">
      <!-- ✅ border 제거: stroke 없음 -->
      <div class="w-full rounded-2xl overflow-hidden shadow-lg bg-black">
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            class="absolute top-0 left-0 w-full h-full"
            src={YT_EMBED}
            title="WOOM brand video"
            loading="lazy"
            frameborder="0"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div
    id="scroll-indicator"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-100 animate-bounce cursor-pointer"
    onclick="document.getElementById('works')?.scrollIntoView({ behavior: 'smooth' });"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0
