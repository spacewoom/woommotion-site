---
const KAKAO_CHANNEL_HOME = "https://pf.kakao.com/_pSgdn";
const KAKAO_DIRECT_CHAT = "https://pf.kakao.com/_pSgdn/chat";

// YouTube video id from https://youtu.be/7oYcwL0jLuk
const BRAND_VIDEO_ID = "7oYcwL0jLuk";
const YT_EMBED = `https://www.youtube.com/embed/${BRAND_VIDEO_ID}?autoplay=1&mute=1&controls=1&rel=0&playsinline=1&loop=1&playlist=${BRAND_VIDEO_ID}`;
---

<section id="home" class="pt-28 pb-16 md:pt-36 md:pb-24 relative">
  <div class="max-w-container mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-gutter md:gap-x-16">
    <!-- LEFT : Copy / CTA -->
    <div class="md:col-span-5 flex flex-col justify-center md:pr-12">
      <!-- Label only -->
      <div class="mb-6">
        <span class="font-mono text-primary text-sm">
          Motion Studio WOOM
        </span>
      </div>

      <!-- Slogan (smaller, single line) -->
      <h1
        class="font-heading text-secondary dark:text-white mb-6 leading-[1.05] tracking-tight whitespace-nowrap text-[clamp(1.85rem,3.1vw,3.2rem)]"
      >
        Imagine it, Create it!
      </h1>

      <!-- Main/Sub text -->
      <p class="text-lg md:text-xl text-secondary/70 dark:text-white/80 mb-4 max-w-3xl mx-auto lg:whitespace-nowrap">
        움직임으로 브랜드 메시지를 설득력 있게 전달합니다.
      </p>

      <p class="text-secondary/70 dark:text-white/70 mb-8 max-w-2xl">
        Menu Board · Promotion · Product/Event · Agency Outsourcing
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-3 mt-2">
        <!-- Left: Works -->
        <a
          href="${prefix}/projects"
          class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-6 border border-primary text-primary hover:bg-primary/10 bg-transparent"
        >
          Works 보기
        </a>

        <!-- Right: Quote Inquiry (direct chat) -->
        <a
          href={KAKAO_DIRECT_CHAT}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-6 bg-primary text-white hover:bg-primary/90"
          aria-label="카카오톡으로 견적 문의 (새 탭)"
        >
          견적 문의 (카카오톡)
        </a>
      </div>

      <!-- optional trust link -->
      <div class="mt-4">
        <a
          href={KAKAO_CHANNEL_HOME}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-secondary/60 dark:text-white/60 hover:text-primary"
        >
          카카오톡 채널 홈에서 정보 확인 →
        </a>
      </div>
    </div>

    <!-- RIGHT : Brand video -->
    <div class="md:col-span-7 mt-10 md:mt-0">
      <!-- ↓ 핵심: 여기 max-w를 줘서 영상만 살짝 줄임(비율 유지) -->
      <div class="relative w-full md:max-w-[92%] lg:max-w-[90%] md:ml-auto">
        <!-- Decorative bg -->
        <div class="absolute -top-8 -right-8 w-80 h-80 md:w-[34rem] md:h-[34rem] bg-gradient-to-br from-primary/10 to-orange-400/10 rounded-3xl -z-10"></div>

        <div class="w-full rounded-2xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-800 bg-black">
          <div class="relative w-full" style="padding-top: 56.25%;">
            <iframe
              class="absolute top-0 left-0 w-full h-full"
              src={YT_EMBED}
              title="WOOM brand video"
              loading="lazy"
              frameborder="0"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <p class="text-xs text-secondary/50 dark:text-white/50 mt-3 text-center">
          * 자동재생은 브라우저 정책에 따라 제한될 수 있어요.
        </p>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator (to Works) -->
  <div
    id="scroll-indicator"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-100 animate-bounce cursor-pointer"
    onclick="document.getElementById('works')?.scrollIntoView({ behavior: 'smooth' });"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary dark:text-highlightBlue">
      <path d="M12 5v14"></path>
      <path d="m19 12-7 7-7-7"></path>
    </svg>
  </div>
</section>
