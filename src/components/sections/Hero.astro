---
import { Image } from 'astro:assets';

import heroBg from '../../assets/Hero_BG.jpg';
import logoCatchphrase from '../../assets/Logo_Catchphrase.svg';
import logoCatchphraseWh from '../../assets/Logo_Catchphrase_Wh.png';

const KAKAO_CHANNEL_HOME = "https://pf.kakao.com/_pSgdn";
const KAKAO_DIRECT_CHAT = "https://pf.kakao.com/_pSgdn/chat";

const BRAND_VIDEO_ID = "7oYcwL0jLuk";
const YT_EMBED = `https://www.youtube.com/embed/${BRAND_VIDEO_ID}?autoplay=1&mute=1&controls=1&rel=0&playsinline=1&loop=1&playlist=${BRAND_VIDEO_ID}`;
---

<section id="home" class="relative pt-28 pb-16 md:pt-36 md:pb-24">
  <!-- ✅ BG 적용 영역: 메뉴바 아래부터 좌/우 끝까지 꽉 채움 -->
  <div class="relative w-full overflow-hidden" style={`--hero-bg:url(${heroBg.src});`}>
    <!-- BG 이미지 (93% 불투명도, 비율 유지 + cover로 crop) -->
    <div
      class="absolute inset-0 -z-10 bg-center bg-cover opacity-[0.93]"
      style="background-image: var(--hero-bg);"
    ></div>

    <!-- (선택) 아주 약한 오버레이: 가독성용 / 필요 없으면 삭제 -->
    <div class="absolute inset-0 -z-10 bg-white/15 dark:bg-black/25"></div>

    <!-- ✅ BG 영역 높이: 화면별 대응(좌우 여백 없이, 과도한 확대 방지) -->
    <div class="relative h-[clamp(520px,72vh,860px)]">
      <div class="max-w-container mx-auto px-6 h-full">
        <div class="h-full flex flex-col items-center justify-center text-center">
          <!-- 로고 (라이트/다크 모드 스왑) -->
          <div>
            <!-- Light mode -->
            <Image
              src={logoCatchphrase}
              alt="WOOM Logo Catchphrase"
              class="w-[260px] sm:w-[320px] md:w-[420px] h-auto dark:hidden"
              loading="eager"
            />

            <!-- Dark mode -->
            <Image
              src={logoCatchphraseWh}
              alt="WOOM Logo Catchphrase (White)"
              class="w-[260px] sm:w-[320px] md:w-[420px] h-auto hidden dark:block"
              loading="eager"
            />
          </div>

          <!-- 카피 -->
          <div class="mt-6 space-y-2">
            <p class="text-base sm:text-lg md:text-xl text-secondary dark:text-white/90">
              ‘움’은 모션그래픽을 기반으로 브랜드 메시지를 설득력 있게 전달합니다.
            </p>
            <p class="text-sm sm:text-base md:text-lg text-secondary/70 dark:text-white/75">
              ‘Woom’ brings brand messages to life with compelling motion graphics.
            </p>
          </div>

          <!-- 버튼: 둘 다 outline, 색상 #003124 -->
          <div class="mt-7 flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="/projects"
              class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-8
                     border border-[#003124] text-[#003124]
                     hover:bg-[#003124]/10 bg-transparent"
            >
              Works 보기
            </a>

            <a
              href={KAKAO_DIRECT_CHAT}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-8
                     border border-[#003124] text-[#003124]
                     hover:bg-[#003124]/10 bg-transparent"
              aria-label="KakaoTalk Inquiry (새 탭)"
            >
              KakaoTalk Inquiry
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ 비디오 영역: BG 밖 (흰 배경/페이지 배경 위에 노출) -->
  <div class="max-w-container mx-auto px-6">
    <div class="mt-10 md:mt-12 mx-auto w-full max-w-[1100px]">
      <div class="w-full rounded-2xl overflow-hidden shadow-lg border border-gray-100/70 dark:border-gray-800/70 bg-black">
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            class="absolute top-0 left-0 w-full h-full"
            src={YT_EMBED}
            title="WOOM brand video"
            loading="lazy"
            frameborder="0"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <p class="text-xs text-secondary/50 dark:text-white/50 mt-3 text-center">
        * 자동재생은 브라우저 정책에 따라 제한될 수 있어요.
      </p>

      <div class="mt-3 text-center">
        <a
          href={KAKAO_CHANNEL_HOME}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-secondary/60 dark:text-white/60 hover:text-[#003124]"
        >
          카카오톡 채널 홈에서 정보 확인 →
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator (원하면 유지 / 필요 없으면 삭제) -->
  <div
    id="scroll-indicator"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-100 animate-bounce cursor-pointer"
    onclick="document.getElementById('works')?.scrollIntoView({ behavior: 'smooth' });"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#003124] dark:text-[#003124]">
      <path d="M12 5v14"></path>
      <path d="m19 12-7 7-7-7"></path>
    </svg>
  </div>
</section>
