---
import Button from "../ui/Buttons.astro";
import { works as allWorks } from "../../data/works.js";

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
const prefix = lang === "de" ? "/de" : "";

const sectionTitle = "Works";
const sectionSubtitle =
  "흥미로운 연출, 명확한 정보 전달, 감각적인 모션으로 브랜드와 제품의 핵심 메시지를 설득력 있게 보여줍니다.";

// -----------------------------
// Utils
// -----------------------------
function parseYear(value: any) {
  const s = String(value ?? "").trim();
  const m = s.match(/\d{4}/);
  if (!m) return 0;
  const y = Number(m[0]);
  return Number.isFinite(y) ? y : 0;
}

function safeLower(v: any) {
  return String(v ?? "").toLowerCase();
}

function hasTag(work: any, tagName: string) {
  const tags = Array.isArray(work?.tags) ? work.tags : [];
  const target = tagName.toLowerCase();
  return tags.some((t: any) => String(t).toLowerCase() === target);
}

function titleIncludes(work: any, keyword: string) {
  return safeLower(work?.title).includes(keyword.toLowerCase());
}

function roleIncludes(work: any, keyword: string) {
  return safeLower(work?.info?.role).includes(keyword.toLowerCase());
}

// ✅ 타이틀 끝의 2자리 숫자 제거
function displayTitle(raw: any) {
  return String(raw ?? "").replace(/\s*\d{2}\s*$/u, "").trim();
}

// 업로드 최신(works 배열 뒤쪽일수록 최신 업로드 가정)
const indexBySlug = new Map(
  (Array.isArray(allWorks) ? allWorks : []).map((w: any, i: number) => [
    w?.slug ?? `__idx_${i}`,
    i,
  ])
);

function getUploadIndex(work: any) {
  return indexBySlug.get(work?.slug) ?? -1;
}

// -----------------------------
// Weighted scoring (NO random)
// -----------------------------
function computeScore(work: any) {
  const year = parseYear(work?.info?.year);
  const upload = getUploadIndex(work);

  let score = year * 10000 + upload;

  if (work?.category === "agency") score += 2000;
  if (work?.category === "digital-signage") score += 1500;

  const hasPlanning = roleIncludes(work, "기획");
  const hasDesign = roleIncludes(work, "디자인");
  if (hasPlanning) score += 2500;
  if (hasDesign) score += 2000;
  if (hasPlanning && hasDesign) score += 1500;

  const isAgency = work?.category === "agency";
  const isSignage = work?.category === "digital-signage";

  const isProductPromo =
    isAgency &&
    (hasTag(work, "Product Promo") ||
      titleIncludes(work, "제품 홍보") ||
      titleIncludes(work, "제품홍보"));
  if (isProductPromo) score += 7000;

  const isInfographic =
    isAgency && (hasTag(work, "Infographic") || titleIncludes(work, "인포그래픽"));
  if (isInfographic) score += 6500;

  const isPop = isSignage && (titleIncludes(work, "pop") || hasTag(work, "POP"));
  if (isPop) score += 6000;

  const hasYoutube =
    (work?.media?.kind === "youtube" && !!work?.media?.src) || !!work?.info?.youtubeUrl;
  if (hasYoutube) score += 300;

  return score;
}

function pickTopWorksWeighted(count = 3) {
  const list = Array.isArray(allWorks) ? allWorks : [];

  const ranked = list
    .map((w: any) => ({
      w,
      score: computeScore(w),
      year: parseYear(w?.info?.year),
      upload: getUploadIndex(w),
    }))
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      if (b.year !== a.year) return b.year - a.year;
      return b.upload - a.upload;
    });

  const picked: any[] = [];
  const usedSlug = new Set<string>();
  const categoryCount = new Map<string, number>();

  for (const item of ranked) {
    if (picked.length >= count) break;
    const w = item.w;
    if (!w?.slug) continue;
    if (usedSlug.has(w.slug)) continue;

    const cat = String(w.category || "unknown");
    const current = categoryCount.get(cat) ?? 0;
    if (current >= 2) continue;

    usedSlug.add(w.slug);
    categoryCount.set(cat, current + 1);
    picked.push(w);
  }

  if (picked.length < count) {
    for (const item of ranked) {
      if (picked.length >= count) break;
      const w = item.w;
      if (!w?.slug) continue;
      if (usedSlug.has(w.slug)) continue;
      usedSlug.add(w.slug);
      picked.push(w);
    }
  }

  return picked.slice(0, count);
}

const homeProjects = pickTopWorksWeighted(3);

function getYoutubeUrl(project: any) {
  if (project?.media?.kind === "youtube" && project?.media?.src) return project.media.src;
  if (project?.info?.youtubeUrl) return project.info.youtubeUrl;
  return "";
}

function getThumb(project: any) {
  return project?.media?.poster || project?.image || "/images/projects/card.jpg";
}

// dataset 안전 인코딩
function enc(v: any) {
  return encodeURIComponent(String(v ?? ""));
}
function encJson(v: any) {
  return encodeURIComponent(JSON.stringify(v ?? []));
}
---

<section id="works" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center flex flex-col items-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {sectionTitle}
      </h2>
      <p class="text-body text-secondary/70 dark:text-white/70 max-w-5xl mx-auto lg:whitespace-nowrap">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {homeProjects.map((project, index) => {
        const youtubeUrl = getYoutubeUrl(project);
        const tags = Array.isArray(project?.tags) ? project.tags : [];
        const thumb = getThumb(project);
        const title = displayTitle(project?.title);

        return (
          <article
            class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="relative overflow-hidden aspect-video">
              <img
                src={thumb}
                alt={title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            {/* ✅ 영상 보기 버튼: 이미지 바로 아래 / 반드시 <button> 사용 */}
            <div class="px-6 pt-5">
              {youtubeUrl ? (
                <button
                  type="button"
                  class="w-full inline-flex items-center justify-center rounded-lg font-medium text-sm py-2.5 border border-primary text-primary hover:bg-primary/10 bg-transparent"
                  data-open-homework="true"
                  data-work-index={index}
                  data-src={enc(youtubeUrl)}
                  data-title={enc(title)}
                  data-summary={enc(project?.summary)}
                  data-year={enc(project?.info?.year)}
                  data-role={enc(project?.info?.role)}
                  data-category={enc(project?.category)}
                  data-tags={encJson(tags)}
                  aria-label={`${title} 영상 보기`}
                >
                  영상 보기
                </button>
              ) : (
                <span class="w-full inline-flex items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 text-secondary/60 dark:text-white/50 py-2.5 text-sm">
                  영상 링크 준비중
                </span>
              )}
            </div>

            <div class="p-6 pt-4">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">
                {title}
              </h3>

              {/* ✅ summary: 카드 레이아웃 기반 2줄만 노출 + 말줄임 */}
              <p class="work-summary text-secondary/70 dark:text-white/70 mb-4">
                {project?.summary}
              </p>

              {/* ✅ 정보 순서: 작업연도 → 역할 → 태그 */}
              <ul class="text-sm text-secondary/70 dark:text-white/70 space-y-1 mb-3">
                <li><span class="font-mono">작업연도</span> · {project?.info?.year}</li>
                <li><span class="font-mono">역할</span> · {project?.info?.role}</li>
              </ul>

              {tags.length ? (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <span class="px-3 py-1 text-xs font-mono bg-gray-100 dark:bg-white/10 text-secondary dark:text-white/80 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              ) : null}
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-12 text-center" data-aos="fade-up">
      <Button text="전체 작업 보기" href={`${prefix}/projects`} variant="primary" />
    </div>
  </div>

  {/* ✅ 모달 */}
  <div
    id="home-work-detail-modal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 p-3 md:p-6"
    aria-hidden="true"
  >
    <div class="w-full max-w-7xl max-h-[92vh] rounded-2xl overflow-hidden border border-white/10 bg-black shadow-2xl">
      <div class="flex items-start justify-between gap-3 px-4 py-3 bg-black/70 border-b border-white/10">
        <div class="min-w-0">
          <p id="home-modal-title" class="text-sm md:text-base text-white/95 font-medium truncate"></p>

          <div class="mt-1 flex flex-wrap gap-2 items-center">
            <span id="home-modal-category" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
            <span id="home-modal-year" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
            <span id="home-modal-role" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="home-modal-prev"
            type="button"
            class="px-3 py-1 rounded-lg border border-white/10 text-white/80 hover:text-white hover:border-white/20 disabled:opacity-30"
            aria-label="이전 작업"
          >
            Prev
          </button>

          <span id="home-modal-counter" class="text-[11px] md:text-xs font-mono text-white/60 px-2">
            1 / 3
          </span>

          <button
            id="home-modal-next"
            type="button"
            class="px-3 py-1 rounded-lg border border-white/10 text-white/80 hover:text-white hover:border-white/20 disabled:opacity-30"
            aria-label="다음 작업"
          >
            Next
          </button>

          <button
            id="home-modal-close"
            type="button"
            class="ml-1 text-white/80 hover:text-white px-3 py-1 rounded-lg border border-white/10 hover:border-white/20"
            aria-label="Close modal"
          >
            Close
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-6">
        <div class="lg:col-span-4 bg-black">
          <div class="relative w-full" style="padding-top:56.25%;">
            <div id="home-modal-player" class="absolute inset-0"></div>
          </div>
        </div>

        <div class="lg:col-span-2 bg-black/60 border-t lg:border-t-0 lg:border-l border-white/10 overflow-auto max-h-[92vh]">
          <div class="p-4 md:p-5">
            <h4 class="text-white/90 text-sm md:text-base font-medium mb-2">작업 설명</h4>
            <p id="home-modal-summary" class="text-white/75 text-xs md:text-sm leading-relaxed whitespace-pre-line max-h-44 overflow-auto pr-1"></p>

            <div class="mt-5">
              <h4 class="text-white/90 text-sm md:text-base font-medium mb-2">태그</h4>
              <div id="home-modal-tags" class="flex flex-wrap gap-2"></div>
            </div>

            <div class="mt-6">
              <button
                id="home-modal-replay"
                type="button"
                class="w-full inline-flex items-center justify-center rounded-lg font-medium text-sm py-2.5 bg-white/10 text-white hover:bg-white/15 border border-white/10"
              >
                다시 재생
              </button>
            </div>

            <p class="mt-3 text-[11px] text-white/40">
              * ESC로 닫기 / 바깥 영역 클릭으로 닫기 / ← → 로 이전·다음
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:inline>
    {`
      .work-summary{
        font-size:0.8em;
        display:-webkit-box;
        -webkit-line-clamp:2;
        -webkit-box-orient:vertical;
        overflow:hidden;
      }
    `}
  </style>

  <script is:inline>
    {`
      function initHomeWorksModal(){
        const modal = document.getElementById("home-work-detail-modal");
        const closeBtn = document.getElementById("home-modal-close");
        const replayBtn = document.getElementById("home-modal-replay");
        const prevBtn = document.getElementById("home-modal-prev");
        const nextBtn = document.getElementById("home-modal-next");
        const counterEl = document.getElementById("home-modal-counter");

        const titleEl = document.getElementById("home-modal-title");
        const categoryEl = document.getElementById("home-modal-category");
        const yearEl = document.getElementById("home-modal-year");
        const roleEl = document.getElementById("home-modal-role");
        const summaryEl = document.getElementById("home-modal-summary");
        const tagsEl = document.getElementById("home-modal-tags");
        const playerHost = document.getElementById("home-modal-player");

        if (!modal || !closeBtn || !replayBtn || !prevBtn || !nextBtn || !counterEl ||
            !titleEl || !categoryEl || !yearEl || !roleEl || !summaryEl || !tagsEl || !playerHost) return;

        // 이미 초기화돼 있으면 중복 바인딩 방지
        if (window.__HOME_WORKS_MODAL_INIT__) return;
        window.__HOME_WORKS_MODAL_INIT__ = true;

        const decode = (s) => {
          try { return decodeURIComponent(s || ""); } catch { return String(s || ""); }
        };
        const safeJson = (s) => {
          try { return JSON.parse(decode(s || "[]")); } catch { return []; }
        };
        const getYoutubeId = (url = "") => {
          const m =
            url.match(/youtu\\.be\\/([a-zA-Z0-9_-]{6,})/) ||
            url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/) ||
            url.match(/\\/embed\\/([a-zA-Z0-9_-]{6,})/) ||
            url.match(/\\/shorts\\/([a-zA-Z0-9_-]{6,})/);
          return m ? m[1] : "";
        };
        const categoryLabel = (cat) => {
          const c = String(cat || "").toLowerCase();
          if (c === "agency") return "Category · Agency";
          if (c === "digital-signage") return "Category · Digital Signage";
          return cat ? \`Category · \${cat}\` : "Category · -";
        };
        const renderTags = (tags) => {
          tagsEl.innerHTML = "";
          const list = Array.isArray(tags) ? tags : [];
          if (!list.length) {
            const empty = document.createElement("span");
            empty.className = "text-xs text-white/40";
            empty.textContent = "태그 없음";
            tagsEl.appendChild(empty);
            return;
          }
          list.forEach((tag) => {
            const chip = document.createElement("span");
            chip.className = "px-3 py-1 text-xs font-mono rounded-full bg-white/10 text-white/80 border border-white/10";
            chip.textContent = tag;
            tagsEl.appendChild(chip);
          });
        };

        const buttons = Array.from(document.querySelectorAll('button[data-open-homework="true"]'));
        let currentIndex = 0;

        const mountVideo = (src, title) => {
          playerHost.innerHTML = "";
          const id = getYoutubeId(src);
          if (!id) return;

          // ✅ autoplay + HD 선호(vq) (유튜브가 무시할 수는 있음)
          const embed =
            \`https://www.youtube.com/embed/\${id}?autoplay=1&mute=0&controls=1&rel=0&playsinline=1&vq=hd1080\`;

          const iframe = document.createElement("iframe");
          iframe.className = "w-full h-full";
          iframe.src = embed;
          iframe.title = title || "YouTube video";
          iframe.loading = "lazy";
          iframe.setAttribute("frameborder", "0");
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "true");
          playerHost.appendChild(iframe);
        };

        const updateNav = () => {
          const total = buttons.length || 0;
          counterEl.textContent = \`\${currentIndex + 1} / \${total}\`;
          prevBtn.disabled = currentIndex <= 0;
          nextBtn.disabled = currentIndex >= total - 1;
        };

        const renderByIndex = (idx) => {
          const total = buttons.length || 0;
          if (!total) return;

          currentIndex = Math.max(0, Math.min(total - 1, idx));
          const btn = buttons[currentIndex];

          const src = decode(btn.dataset.src);
          const title = decode(btn.dataset.title);
          const summary = decode(btn.dataset.summary);
          const year = decode(btn.dataset.year);
          const role = decode(btn.dataset.role);
          const category = decode(btn.dataset.category);
          const tags = safeJson(btn.dataset.tags);

          titleEl.textContent = title || "";
          categoryEl.textContent = categoryLabel(category);
          yearEl.textContent = \`작업 연도 · \${year || "-"}\`;
          roleEl.textContent = \`역할 · \${role || "-"}\`;
          summaryEl.textContent = summary || "";
          renderTags(tags);

          mountVideo(src, title);
          updateNav();
        };

        const openModalAt = (idx) => {
          renderByIndex(idx);
          modal.classList.remove("hidden");
          modal.classList.add("flex");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        };

        const closeModal = () => {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          modal.setAttribute("aria-hidden", "true");
          playerHost.innerHTML = "";
          tagsEl.innerHTML = "";
          summaryEl.textContent = "";
          document.body.style.overflow = "";
        };

        // ✅ 이벤트 위임: DOM 변경/재렌더에도 항상 작동
        document.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;

          const btn = t.closest('button[data-open-homework="true"]');
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            const idx = Number(btn.getAttribute("data-work-index") || "0");
            openModalAt(Number.isFinite(idx) ? idx : 0);
            return;
          }
        }, true);

        prevBtn.addEventListener("click", () => renderByIndex(currentIndex - 1));
        nextBtn.addEventListener("click", () => renderByIndex(currentIndex + 1));
        replayBtn.addEventListener("click", () => renderByIndex(currentIndex));

        closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });

        document.addEventListener("keydown", (e) => {
          if (modal.classList.contains("hidden")) return;
          if (e.key === "Escape") closeModal();
          if (e.key === "ArrowLeft") renderByIndex(currentIndex - 1);
          if (e.key === "ArrowRight") renderByIndex(currentIndex + 1);
        });

        updateNav();
      }

      // ✅ Astro 페이지 전환/부분 로드까지 커버
      document.addEventListener("DOMContentLoaded", initHomeWorksModal);
      document.addEventListener("astro:page-load", initHomeWorksModal);
    `}
  </script>
</section>
