---
import Button from '../ui/Buttons.astro';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

const sectionTitle = 'Works';
const sectionSubtitle =
  '흥미로운 연출, 명확한 정보 전달, 감각적인 모션으로 브랜드와 제품의 핵심 메시지를 설득력 있게 보여줍니다.';

const projects = [
  {
    title: '인포그래픽 | 기후동행카드 (35s)',
    slug: 'infographics-01',
    image: '/images/projects/card.jpg',
    tags: ['인포그래픽', '모션그래픽'],
    summary:
      '텍스트를 최소화하고 직관적인 이미지 중심으로 구성해, 짧은 시간 안에 핵심 정보가 이해되도록 디자인했습니다.',
    info: {
      year: '2024',
      duration: '35s',
      role: '기획 · 디자인 · 애니메이션',
      youtubeUrl: 'https://youtu.be/LLY3FR1Sb3I?si=1O3wcJZANL766oDf'
    },
  },
  {
    title: '프로모션 | Prmr 크루 모집',
    slug: 'promotion-01',
    image: '/images/projects/prmr.jpg',
    tags: ['타이포그래픽', '프로모션'],
    summary:
      '리드미컬한 타이포 키네틱과 화면 템포를 중심으로, 메시지가 빠르고 선명하게 전달되도록 제작했습니다.',
    info: {
      year: '2024',
      duration: '15s',
      role: '기획 · 디자인 · 애니메이션',
      youtubeUrl: 'https://youtu.be/K_o555Ywq28?si=hvlUgRNbGhntTqAI'
    },
  },
  {
    title: '제품 홍보 | Grida pencil',
    slug: 'product-01',
    image: '/images/projects/grida.jpg',
    tags: ['제품 홍보', '모션그래픽'],
    summary:
      '“아이디어는 끄적이는 순간부터 시작된다”는 메시지를 중심으로 드로잉 요소와 모션을 결합해 생동감 있게 표현했습니다.',
    info: {
      year: '2022',
      duration: '30s 내외',
      role: '기획 · 디자인· 애니메이션 · 3D 모델링',
      youtubeUrl: 'https://youtu.be/dcmq0tn98So?si=jOl7SytoZ3DJiQWZ'
    },
  },
];

// ✅ 타이틀 끝의 2자리 숫자 제거 (예: 메뉴보드 01 → 메뉴보드)
function displayTitle(raw: string) {
  return String(raw ?? '').replace(/\s*\d{2}\s*$/u, '').trim();
}
---

<section id="works" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center flex flex-col items-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {sectionTitle}
      </h2>
      <p class="text-body text-secondary/70 dark:text-white/70 max-w-5xl mx-auto lg:whitespace-nowrap">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {projects.map((project, index) => {
        const title = displayTitle(project.title);
        const hasVideo = Boolean(project?.info?.youtubeUrl);
        const tags = Array.isArray(project.tags) ? project.tags : [];

        // 모달 전달값 (안전하게 인코딩)
        const summaryEncoded = encodeURIComponent(String(project?.summary ?? ""));
        const roleEncoded = encodeURIComponent(String(project?.info?.role ?? ""));
        const yearEncoded = encodeURIComponent(String(project?.info?.year ?? ""));
        const tagsEncoded = encodeURIComponent(JSON.stringify(tags));

        return (
          <div
            class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="relative overflow-hidden aspect-video">
              <img
                src={project.image}
                alt={title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <div class="p-6">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">
                {title}
              </h3>

              {/* ✅ summary 크기 80% */}
              <p class="work-summary text-secondary/70 dark:text-white/70 mb-4">
                {project.summary}
              </p>

              {/* ✅ 정보 영역: 작업연도 → 역할 → 태그 */}
              <ul class="text-sm text-secondary/70 dark:text-white/70 space-y-1 mb-3">
                <li><span class="font-mono">작업연도</span> · {project.info.year}</li>
                <li><span class="font-mono">역할</span> · {project.info.role}</li>
              </ul>

              {tags.length ? (
                <div class="flex flex-wrap gap-2 mb-6">
                  {tags.map((tag) => (
                    <span class="px-3 py-1 text-xs font-mono bg-gray-100 dark:bg-white/10 text-secondary dark:text-white/80 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              ) : (
                <div class="mb-6" />
              )}

              {/* ✅ 버튼 텍스트 변경 + 페이지 내 모달 오픈 */}
              <button
                type="button"
                class={
                  hasVideo
                    ? "inline-flex items-center justify-center rounded-lg font-medium text-sm py-2 px-4 border border-primary text-primary hover:bg-primary/10 bg-transparent"
                    : "inline-flex items-center justify-center rounded-lg font-medium text-sm py-2 px-4 border border-gray-200 dark:border-gray-700 text-secondary/40 dark:text-white/30 bg-transparent cursor-not-allowed"
                }
                data-open-homework={hasVideo ? "true" : "false"}
                data-video-kind="youtube"
                data-video-src={project.info.youtubeUrl}
                data-video-title={title}
                data-video-summary={summaryEncoded}
                data-video-role={roleEncoded}
                data-video-year={yearEncoded}
                data-video-category={encodeURIComponent("home-works")}
                data-video-tags={tagsEncoded}
                disabled={!hasVideo}
                aria-label={hasVideo ? `${title} 영상 보기` : `${title} (영상 링크 없음)`}
              >
                영상 보기
              </button>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-12 text-center" data-aos="fade-up">
      <Button text="전체 작업 보기" href="/projects" variant="primary" />
    </div>
  </div>

  <!-- ✅ 홈 Works 섹션용 상세 모달 (ProjectsPage.astro와 동일 컨셉: 좌 영상 / 우 상세) -->
  <div
    id="home-work-detail-modal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 p-3 md:p-6"
    aria-hidden="true"
  >
    <div class="w-full max-w-7xl max-h-[92vh] rounded-2xl overflow-hidden border border-white/10 bg-black shadow-2xl">
      <div class="flex items-start justify-between gap-3 px-4 py-3 bg-black/70 border-b border-white/10">
        <div class="min-w-0">
          <p id="home-modal-title" class="text-sm md:text-base text-white/95 font-medium truncate"></p>
          <div class="mt-1 flex flex-wrap gap-2 items-center">
            <span id="home-modal-year" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
            <span id="home-modal-role" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
          </div>
        </div>

        <button
          id="home-modal-close"
          type="button"
          class="shrink-0 text-white/80 hover:text-white px-3 py-1 rounded-lg border border-white/10 hover:border-white/20"
          aria-label="Close modal"
        >
          Close
        </button>
      </div>

      <!-- ✅ 영상 영역을 크게: lg 6칸 중 4칸 / 우측 정보 2칸 -->
      <div class="grid grid-cols-1 lg:grid-cols-6">
        <div class="lg:col-span-4 bg-black">
          <div class="relative w-full" style="padding-top:56.25%;">
            <div id="home-modal-player" class="absolute inset-0"></div>
          </div>
        </div>

        <div class="lg:col-span-2 bg-black/60 border-t lg:border-t-0 lg:border-l border-white/10 overflow-auto max-h-[92vh]">
          <div class="p-4 md:p-5">
            <h4 class="text-white/90 text-sm md:text-base font-medium mb-2">작업 설명</h4>
            <p id="home-modal-summary" class="text-white/75 text-xs md:text-sm leading-relaxed whitespace-pre-line max-h-44 overflow-auto pr-1"></p>

            <div class="mt-5">
              <h4 class="text-white/90 text-sm md:text-base font-medium mb-2">태그</h4>
              <div id="home-modal-tags" class="flex flex-wrap gap-2"></div>
            </div>

            <div class="mt-6">
              <button
                id="home-modal-replay"
                type="button"
                class="w-full inline-flex items-center justify-center rounded-lg font-medium text-sm py-2.5 bg-white/10 text-white hover:bg-white/15 border border-white/10"
              >
                다시 재생
              </button>
            </div>

            <p class="mt-3 text-[11px] text-white/40">
              * ESC로 닫기 / 바깥 영역 클릭으로 닫기
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:inline>
    {`
      .work-summary{
        font-size:0.8em; /* ✅ summary 80% */
      }
    `}
  </style>

  <script is:inline>
    {`
      document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById("home-work-detail-modal");
        const closeBtn = document.getElementById("home-modal-close");
        const replayBtn = document.getElementById("home-modal-replay");

        const titleEl = document.getElementById("home-modal-title");
        const yearEl = document.getElementById("home-modal-year");
        const roleEl = document.getElementById("home-modal-role");
        const summaryEl = document.getElementById("home-modal-summary");
        const tagsEl = document.getElementById("home-modal-tags");
        const player = document.getElementById("home-modal-player");

        if (!modal || !closeBtn || !replayBtn || !titleEl || !yearEl || !roleEl || !summaryEl || !tagsEl || !player) return;

        let lastVideo = { kind: "youtube", src: "", title: "" };

        const safeDecode = (s = "") => {
          try { return decodeURIComponent(s); } catch { return String(s || ""); }
        };

        const safeJson = (s = "[]") => {
          try { return JSON.parse(s); } catch { return []; }
        };

        const getYoutubeId = (url = "") => {
          const m =
            url.match(/youtu\\.be\\/([a-zA-Z0-9_-]{6,})/) ||
            url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/) ||
            url.match(/\\/embed\\/([a-zA-Z0-9_-]{6,})/) ||
            url.match(/\\/shorts\\/([a-zA-Z0-9_-]{6,})/);
          return m ? m[1] : "";
        };

        const renderTags = (tags) => {
          tagsEl.innerHTML = "";
          const list = Array.isArray(tags) ? tags : [];
          if (!list.length) {
            const empty = document.createElement("span");
            empty.className = "text-xs text-white/40";
            empty.textContent = "태그 없음";
            tagsEl.appendChild(empty);
            return;
          }
          list.forEach((tag) => {
            const chip = document.createElement("span");
            chip.className = "px-3 py-1 text-xs font-mono rounded-full bg-white/10 text-white/80 border border-white/10";
            chip.textContent = tag;
            tagsEl.appendChild(chip);
          });
        };

        const mountVideo = (src, title) => {
          player.innerHTML = "";
          if (!src) return;

          const id = getYoutubeId(src);
          const embed = id
            ? \`https://www.youtube.com/embed/\${id}?autoplay=1&mute=0&controls=1&rel=0&playsinline=1\`
            : src;

          const iframe = document.createElement("iframe");
          iframe.className = "w-full h-full";
          iframe.src = embed;
          iframe.title = title || "YouTube video";
          iframe.loading = "lazy";
          iframe.setAttribute("frameborder", "0");
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "true");
          player.appendChild(iframe);
        };

        const openModal = ({ src, title, summary, year, role, tags }) => {
          lastVideo = { kind: "youtube", src, title };

          titleEl.textContent = title || "";
          yearEl.textContent = \`작업 연도 · \${year || "-"}\`;
          roleEl.textContent = \`역할 · \${role || "-"}\`;
          summaryEl.textContent = summary || "";
          renderTags(tags);

          mountVideo(src, title);

          modal.classList.remove("hidden");
          modal.classList.add("flex");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        };

        const closeModal = () => {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          modal.setAttribute("aria-hidden", "true");
          player.innerHTML = "";
          tagsEl.innerHTML = "";
          summaryEl.textContent = "";
          document.body.style.overflow = "";
        };

        // ✅ "영상 보기" 버튼 클릭
        const buttons = document.querySelectorAll("button[data-open-homework='true']");
        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const src = btn.getAttribute("data-video-src") || "";
            const title = btn.getAttribute("data-video-title") || "";

            const summary = safeDecode(btn.getAttribute("data-video-summary") || "");
            const year = safeDecode(btn.getAttribute("data-video-year") || "");
            const role = safeDecode(btn.getAttribute("data-video-role") || "");
            const tagsRaw = safeDecode(btn.getAttribute("data-video-tags") || "[]");
            const tags = safeJson(tagsRaw);

            if (!src) return;
            openModal({ src, title, summary, year, role, tags });
          });
        });

        closeBtn.addEventListener("click", closeModal);

        replayBtn.addEventListener("click", () => {
          if (!lastVideo?.src) return;
          mountVideo(lastVideo.src, lastVideo.title);
        });

        modal.addEventListener("click", (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
        });
      });
    `}
  </script>
</section>
