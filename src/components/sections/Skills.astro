---
import { VideoIcon, PaintbrushIcon, BotIcon, UsersIcon } from '@lucide/astro';
import { getLangFromUrl } from '../../utils/getLangFromUrl';
import { t } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);

/**
 * Notes
 * - Keep all text via i18n keys (en/de structure preserved).
 * - Only some tool icons are swapped to SVG files in /public/icons/tools/.
 * - For dark mode, we rely on `dark:invert` (your icons are black-on-transparent).
 */
const skillClusters = [
  {
    key: 'motion',
    title: t('skills.motion.title', lang),
    description: t('skills.motion.description', lang),
    icon: VideoIcon,
    tools: [
      { name: 'After Effects', icon: VideoIcon },
      { name: 'Media Encoder', iconSrc: '/icons/tools/media-encoder.svg' },
      { name: 'Procreate', iconSrc: '/icons/tools/procreate.svg' },
    ],
  },
  {
    key: 'design',
    title: t('skills.design.title', lang),
    description: t('skills.design.description', lang),
    icon: PaintbrushIcon,
    tools: [
      { name: 'Photoshop', icon: PaintbrushIcon },
      { name: 'Illustrator', icon: PaintbrushIcon },
      { name: 'Procreate', iconSrc: '/icons/tools/procreate.svg' },
    ],
  },
  {
    key: 'ai',
    title: t('skills.ai.title', lang),
    description: t('skills.ai.description', lang),
    icon: BotIcon,
    tools: [
      { name: 'Sora', iconSrc: '/icons/tools/sora.svg' },
      { name: 'Nanobanana', iconSrc: '/icons/tools/nanobanana.svg' },
      { name: 'Veo', iconSrc: '/icons/tools/veo.svg' },
      // Kling은 “video.svg” 아이콘을 재사용
      { name: 'Kling', iconSrc: '/icons/tools/video.svg' },
      { name: 'ChatGPT', icon: BotIcon },
    ],
  },
  {
    key: 'collab',
    title: t('skills.collab.title', lang),
    description: t('skills.collab.description', lang),
    icon: UsersIcon,
    tools: [
      { name: 'KakaoTalk', iconSrc: '/icons/tools/kakaotalk.svg' },
      { name: 'Google Drive', iconSrc: '/icons/tools/google-drive.svg' },
    ],
  },
];
---

<section id="skills" class="relative scroll-mt-24 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-12 flex flex-col gap-4">
      <p class="inline-flex w-fit items-center gap-2 rounded-full border border-border/60 bg-background/50 px-3 py-1 text-sm text-muted-foreground">
        <span class="h-2 w-2 rounded-full bg-foreground/70"></span>
        {t('skills.kicker', lang)}
      </p>

      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        {t('skills.title', lang)}
      </h2>
      <p class="max-w-2xl text-pretty text-muted-foreground">
        {t('skills.subtitle', lang)}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {skillClusters.map((cluster) => (
        <article
          class="group rounded-2xl border border-border/60 bg-card/30 p-6 shadow-sm backdrop-blur transition hover:border-border"
          data-aos="fade-up"
        >
          <div class="flex items-start gap-4">
            <div class="grid h-12 w-12 place-items-center rounded-xl border border-border/60 bg-background/60 shadow-sm">
              <cluster.icon class="h-6 w-6 text-foreground" />
            </div>

            <div class="flex-1">
              <h3 class="text-lg font-semibold leading-snug">{cluster.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                {cluster.description}
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                {cluster.tools.map((tool) => (
                  <span class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-background/50 px-3 py-1 text-sm text-muted-foreground">
                    {tool.iconSrc ? (
                      <img
                        src={tool.iconSrc}
                        alt={tool.name}
                        class="h-5 w-5 dark:invert"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <tool.icon class="h-5 w-5 text-foreground/80" />
                    )}
                    <span>{tool.name}</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
