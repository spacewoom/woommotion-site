---
import Button from '../ui/Buttons.astro';
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;


const timelineItems = [
  {
    title: t('timeline.items.item1.title', locale),
    englishTitle: t('timeline.items.item1.englishTitle', locale),
    description: t('timeline.items.item1.description', locale),
  },
  {
    title: t('timeline.items.item2.title', locale),
    englishTitle: t('timeline.items.item2.englishTitle', locale),
    description: t('timeline.items.item2.description', locale),
  },
  {
    title: t('timeline.items.item3.title', locale),
    englishTitle: t('timeline.items.item3.englishTitle', locale),
    description: t('timeline.items.item3.description', locale),
  },
  {
    title: t('timeline.items.item4.title', locale),
    englishTitle: t('timeline.items.item4.englishTitle', locale),
    description: t('timeline.items.item4.description', locale),
  },
  {
    title: t('timeline.items.item5.title', locale),
    englishTitle: t('timeline.items.item5.englishTitle', locale),
    description: t('timeline.items.item5.description', locale),
  },
];
---

<Section
  id="timeline"
  title={t('timeline.title', locale)}
  subtitle={t('timeline.subtitle', locale)}
>
  <div class="timeline-container relative mx-auto mt-16 max-w-5xl">
    <!-- LEFT LINE -->
    <div class="absolute left-6 top-0 h-full w-px bg-primary/20"></div>

    <!-- ITEMS (ONE COLUMN / LEFT ALIGNED) -->
    <div class="space-y-12">
      {
        timelineItems.map((item, index) => (
          <div
            class="relative"
            data-aos={index % 2 === 0 ? 'fade-left' : undefined}
          >
            {/* DOT */}
            <div
              class="timeline-dot absolute left-6 top-2 h-5 w-5 -translate-x-1/2 rounded-full bg-primary transition-transform duration-300"
            ></div>

            {/* CONTENT */}
            <div class="w-full pl-16 md:pl-[190px]">
              <h3 class="text-left text-xl font-bold text-primary">
                {item.title}
                <span class="block text-base font-medium text-primary/80">
                  {item.englishTitle}
                </span>
              </h3>

              <p class="mt-2 text-left text-secondary/70">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<script>
  // Dot interaction + scroll highlight (keep minimal / no dependency changes)
  document.addEventListener('DOMContentLoaded', () => {
    const dots = document.querySelectorAll('.timeline-dot');

    // Add hover effect to dots
    dots.forEach((dot) => {
      dot.addEventListener('mouseenter', () => {
        dot.style.transform = 'translateX(-50%) scale(1.5)';
      });

      dot.addEventListener('mouseleave', () => {
        dot.style.transform = 'translateX(-50%) scale(1)';
      });
    });

    // Add scroll effect to highlight active dot
    window.addEventListener('scroll', () => {
      const scrollPosition = window.scrollY + window.innerHeight / 2;

      dots.forEach((dot) => {
        const dotPosition = dot.getBoundingClientRect().top + window.scrollY;

        if (dotPosition < scrollPosition) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  /* Active dot state */
  .timeline-dot.active {
    transform: translateX(-50%) scale(1.2);
    box-shadow: 0 0 10px rgba(var(--color-primary), 0.5);
  }

  /* Smooth hover transition */
  .timeline-dot {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
</style>
