---
import Button from '../ui/Buttons.astro';
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

const timelineItems = [
  { titleKey: "timeline.item1Title", subtitleKey: "timeline.item1Subtitle" },
  { titleKey: "timeline.item2Title", subtitleKey: "timeline.item2Subtitle" },
  { titleKey: "timeline.item3Title", subtitleKey: "timeline.item3Subtitle" },
  { titleKey: "timeline.item4Title", subtitleKey: "timeline.item4Subtitle" },
  { titleKey: "timeline.item5Title", subtitleKey: "timeline.item5Subtitle" },
];
---

<section id="timeline" class="relative py-24 overflow-hidden">
  <!-- background blur (기존 톤 유지용) -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl opacity-60"></div>
  <div class="absolute bottom-20 right-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl opacity-60"></div>

    <div class="max-w-container mx-auto px-6">
    <div class="mb-12" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {t('timeline.title', lang)}
      </h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl">
        {t('timeline.subtitle', lang)}
      </p>
    </div>

    <!-- timeline -->
    <div class="timeline-container relative">
      <!-- vertical line (왼쪽 고정) -->
      <div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700"></div>

      <div class="space-y-10">
        {timelineItems.map((item) => (
          <div class="timeline-item relative">
            {/* dot */}
            <div
              class="
                absolute left-4 top-6
                -translate-x-1/2
                w-3.5 h-3.5 rounded-full
                bg-neutral-dark dark:bg-neutral-light
                ring-4 ring-neutral-light dark:ring-neutral-dark
              "
              aria-hidden="true"
            ></div>

            {/* content: dot 기준 들여쓰기 (모바일은 과하지 않게, md에서 150px) */}
            <div class="pl-16 sm:pl-20 md:pl-[150px]">
              <div
                class="
                  rounded-2xl border border-neutral-dark/10 dark:border-neutral-light/10
                  bg-neutral-light/60 dark:bg-neutral-dark/60
                  backdrop-blur
                  p-6 md:p-7
                "
              >
                <h3 class="text-xl md:text-2xl font-semibold text-secondary dark:text-white text-left">
                  {t(item.titleKey, locale)}
                </h3>
                <p class="mt-3 text-base md:text-lg text-secondary/80 dark:text-white/80 text-left">
                  {t(item.subtitleKey, locale)}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
