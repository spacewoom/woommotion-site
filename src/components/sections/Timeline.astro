---
import Section from "../layout/Section.astro";
import { t } from "../../utils/i18n";
import { getLangFromUrl } from "../../utils/getLangFromUrl";

const lang = getLangFromUrl(Astro.url);

// NOTE: 아래 데이터 구조/키는 기존(배포 성공했던) 구조를 그대로 유지해야 애니메이션이 유지됩니다.
const timeline = [
  { titleKey: "timeline.step1.title", subtitleKey: "timeline.step1.subtitle" },
  { titleKey: "timeline.step2.title", subtitleKey: "timeline.step2.subtitle" },
  { titleKey: "timeline.step3.title", subtitleKey: "timeline.step3.subtitle" },
  { titleKey: "timeline.step4.title", subtitleKey: "timeline.step4.subtitle" },
  { titleKey: "timeline.step5.title", subtitleKey: "timeline.step5.subtitle" },
];
---

<Section id="journey" class="relative overflow-hidden">
  <div class="max-w-container mx-auto px-6 py-20">
    <div class="mb-12">
      <h2 class="text-4xl font-bold tracking-tight text-white mb-4">
        {t(lang, "timeline.title")}
      </h2>
      <!-- ✅ 1) 섹션 subtitle: 항상 왼쪽 정렬 -->
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl text-left">
        {t(lang, "timeline.subtitle")}
      </p>
    </div>

    <div class="relative timeline-container">
      <div class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-white/10"></div>

      <ul class="space-y-10">
        {timeline.map((item, index) => {
          const isLeft = index % 2 === 0;

          return (
            <li class="relative timeline-item">
              <div class={`grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10 items-start`}>
                {/* LEFT */}
                <div class={`${isLeft ? "md:text-right" : "md:order-2 md:text-left"} px-2`}>
                  <div class={`${isLeft ? "md:ml-auto" : ""} max-w-md`}>
                    <h3 class="text-xl font-semibold text-white">
                      {t(lang, item.titleKey)}
                    </h3>

                    {/* ✅ 2) 각 아이템 subtitle(설명): 항상 왼쪽 정렬 */}
                    <p class="mt-2 text-secondary/70 dark:text-white/70 text-left">
                      {t(lang, item.subtitleKey)}
                    </p>
                  </div>
                </div>

                {/* RIGHT (empty column to keep alternating layout) */}
                <div class={`${isLeft ? "md:order-2" : ""} px-2`}></div>
              </div>

              {/* center dot */}
              <span class="absolute left-1/2 top-2 h-3 w-3 -translate-x-1/2 rounded-full bg-white"></span>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</Section>
