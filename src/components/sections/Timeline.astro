---
/**
 * Timeline.astro
 * - Keeps original animation hooks: #timeline, .timeline-item (used by src/scripts/animations.js)
 * - Minimal-risk: no new dependencies, no fragile imports
 * - Titles: 2 lines (KO first, EN second with 80% opacity)
 * - All subtitles aligned left
 * - Force left-align titles for: Client Request (Payment), Design, Delivery & Revisions
 */

const lang = Astro.props.lang ?? "en"; // kept for compatibility (even if not used)

const timelineItems = [
  {
    key: "client",
    titleKo: "클라이언트 요청 · 결제",
    titleEn: "Client Request (Payment)",
    subtitle:
      "요청 내용을 확인하고 예산/일정/목표를 정리합니다. 확정된 범위 기준으로 견적 안내 후 결제 단계로 진행됩니다.",
  },
  {
    key: "planning",
    titleKo: "기획",
    titleEn: "Planning",
    subtitle:
      "콘셉트와 메시지 우선순위를 정리하고, 화면 구성/연출 방향/필요 소재를 정의합니다. 목적에 맞는 흐름으로 설계를 고도화합니다.",
  },
  {
    key: "design",
    titleKo: "디자인",
    titleEn: "Design",
    subtitle:
      "키비주얼/레이아웃/타이포 스타일을 잡아 시안을 공유합니다. 클라이언트 확인 후 최종안을 확정하고 모션 단계로 넘어갑니다.",
  },
  {
    key: "motion",
    titleKo: "모션",
    titleEn: "Motion",
    subtitle:
      "타이포/그래픽 모션과 리듬을 설계해 시선을 끄는 움직임으로 완성합니다. 매체/송출 환경에 맞춰 디테일까지 다듬습니다.",
  },
  {
    key: "delivery",
    titleKo: "납품 · 수정",
    titleEn: "Delivery & Revisions",
    subtitle:
      "최종 납품 후 피드백 기반으로 3회 무상 수정이 가능합니다. 방향 전환/전체 구조 변경 등 과도한 수정은 추가 비용이 발생할 수 있으며, 운영자 실수로 인한 수정은 차감되지 않습니다.",
  },
];

// These three titles must be aligned left (even on desktop where some items are right-aligned)
const forceLeftTitleKeys = new Set(["client", "design", "delivery"]);
---

<section id="timeline" class="py-20">
  <div class="mx-auto max-w-6xl px-4">
    <!-- Section header -->
    <div class="mb-12">
      <h2 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">
        작업 흐름
        <span class="block text-base font-medium text-gray-600 dark:text-gray-300 opacity-80">
          Workflow
        </span>
      </h2>

      <!-- All subtitles left-aligned -->
      <p class="mt-3 max-w-2xl text-left text-sm leading-6 text-gray-600 dark:text-gray-300">
        의뢰부터 납품까지, 목적에 맞는 구조로 정리해 안정적으로 완성합니다.
      </p>
    </div>

    <!-- Timeline rail -->
    <div class="relative">
      <!-- vertical line -->
      <div class="absolute left-4 top-0 h-full w-px bg-gray-200 dark:bg-gray-800 md:left-1/2"></div>

      <div class="space-y-10">
        {timelineItems.map((item, index) => {
          const isRightSide = index % 2 === 1; // alternate
          const forceLeftTitle = forceLeftTitleKeys.has(item.key);

          // Desktop alignment for the content block:
          // - Alternate left/right like typical timeline
          // - On mobile: always left
          const rowClass = isRightSide ? "md:flex-row-reverse" : "";
          const contentAlignClass = isRightSide ? "md:items-end md:text-right" : "md:items-start md:text-left";

          // Title alignment rules:
          // - Default follows side alignment
          // - But forced keys must be left-aligned even if on right side
          const titleAlignClass = forceLeftTitle
            ? "text-left md:text-left"
            : isRightSide
              ? "text-left md:text-right"
              : "text-left md:text-left";

          return (
            <div class={`timeline-item relative flex items-start gap-6 md:gap-10 ${rowClass}`}>
              <!-- dot -->
              <div class="relative z-10 mt-1 flex w-8 shrink-0 justify-center md:w-1/2">
                <div class="h-3 w-3 rounded-full bg-gray-900 dark:bg-white ring-4 ring-white dark:ring-gray-950"></div>
              </div>

              <!-- content -->
              <div class={`w-full md:w-1/2 flex flex-col ${contentAlignClass}`}>
                <div class="rounded-2xl border border-gray-200 bg-white/70 p-6 shadow-sm backdrop-blur dark:border-gray-800 dark:bg-white/5">
                  <!-- Title: 2 lines (KO / EN with 80% opacity) -->
                  <h3 class={`text-lg font-semibold leading-tight text-gray-900 dark:text-white ${titleAlignClass}`}>
                    <span class="block">{item.titleKo}</span>
                    <span class="block text-sm font-medium text-gray-600 dark:text-gray-300 opacity-80">
                      {item.titleEn}
                    </span>
                  </h3>

                  <!-- Subtitle: always left aligned -->
                  <p class="mt-3 text-left text-sm leading-6 text-gray-600 dark:text-gray-300">
                    {item.subtitle}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
