---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

const splitTitle = (raw: string) => {
  const parts = raw.split(' | ');
  return {
    ko: (parts[0] ?? raw).trim(),
    en: (parts[1] ?? '').trim(),
  };
};

const c1 = splitTitle(t('values.card1Title', lang));
const c2 = splitTitle(t('values.card2Title', lang));
const c3 = splitTitle(t('values.card3Title', lang));
const c4 = splitTitle(t('values.card4Title', lang));
---

<section id="services" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {t('values.title', lang)}
      </h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-3xl mx-auto">
        {t('values.subtitle', lang)}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Card 1 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-[1.02] hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="mb-6 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="v1">
            <title id="v1">{c1.ko}</title>
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 leading-tight group-hover:text-primary transition-colors duration-300">
          <span class="block text-xl">{c1.ko}</span>
          {c1.en && <span class="block text-sm text-secondary/60 dark:text-white/60 mt-1">{c1.en}</span>}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card1Text', lang)}
        </p>
      </div>

      <!-- Card 2 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-[1.02] hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="mb-6 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="v2">
            <title id="v2">{c2.ko}</title>
            <path d="M12 20h9"></path>
            <path d="M12 4h9"></path>
            <path d="M4 9h16"></path>
            <path d="M4 15h16"></path>
            <path d="M7 4v16"></path>
          </svg>
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 leading-tight group-hover:text-primary transition-colors duration-300">
          <span class="block text-xl">{c2.ko}</span>
          {c2.en && <span class="block text-sm text-secondary/60 dark:text-white/60 mt-1">{c2.en}</span>}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card2Text', lang)}
        </p>
      </div>

      <!-- Card 3 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-[1.02] hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="mb-6 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="v3">
            <title id="v3">{c3.ko}</title>
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <path d="M3.3 7l8.7 5 8.7-5"></path>
            <path d="M12 22V12"></path>
          </svg>
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 leading-tight group-hover:text-primary transition-colors duration-300">
          <span class="block text-xl">{c3.ko}</span>
          {c3.en && <span class="block text-sm text-secondary/60 dark:text-white/60 mt-1">{c3.en}</span>}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card3Text', lang)}
        </p>
      </div>

      <!-- Card 4 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-[1.02] hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <div class="mb-6 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="v4">
            <title id="v4">{c4.ko}</title>
            <rect x="3" y="4" width="18" height="14" rx="2"></rect>
            <path d="M7 20h10"></path>
            <path d="M9 16v4"></path>
            <path d="M15 16v4"></path>
          </svg>
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 leading-tight group-hover:text-primary transition-colors duration-300">
          <span class="block text-xl">{c4.ko}</span>
          {c4.en && <span class="block text-sm text-secondary/60 dark:text-white/60 mt-1">{c4.en}</span>}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card4Text', lang)}
        </p>
      </div>
    </div>
  </div>
</section>
