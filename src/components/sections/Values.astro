---
import { t } from '../../utils/i18n'; // ✅ 중요: 이 파일 경로가 실제로 존재해야 빌드가 됨

interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;

function splitTitle(title: string) {
  const [ko, en] = title.split(' | ').map((s) => s?.trim());
  return { ko: ko ?? title, en: en ?? '' };
}

const card1 = splitTitle(t('values.card1Title', lang));
const card2 = splitTitle(t('values.card2Title', lang));
const card3 = splitTitle(t('values.card3Title', lang));
const card4 = splitTitle(t('values.card4Title', lang));
---

<section id="services" class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-10 sm:mb-14">
      <p class="text-xs uppercase tracking-[0.22em] text-neutral-500">
        {t('values.title', lang)}
      </p>
      <h2 class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
        {t('values.subtitle', lang)}
      </h2>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Card 1 -->
      <article class="rounded-2xl border border-neutral-200/70 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/40 p-6 backdrop-blur">
        <h3 class="leading-tight">
          <span class="block text-lg font-semibold text-neutral-900 dark:text-neutral-100">{card1.ko}</span>
          {card1.en && <span class="block mt-1 text-sm text-neutral-500">{card1.en}</span>}
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          {t('values.card1Text', lang)}
        </p>
      </article>

      <!-- Card 2 -->
      <article class="rounded-2xl border border-neutral-200/70 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/40 p-6 backdrop-blur">
        <h3 class="leading-tight">
          <span class="block text-lg font-semibold text-neutral-900 dark:text-neutral-100">{card2.ko}</span>
          {card2.en && <span class="block mt-1 text-sm text-neutral-500">{card2.en}</span>}
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          {t('values.card2Text', lang)}
        </p>
      </article>

      <!-- Card 3 -->
      <article class="rounded-2xl border border-neutral-200/70 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/40 p-6 backdrop-blur">
        <h3 class="leading-tight">
          <span class="block text-lg font-semibold text-neutral-900 dark:text-neutral-100">{card3.ko}</span>
          {card3.en && <span class="block mt-1 text-sm text-neutral-500">{card3.en}</span>}
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          {t('values.card3Text', lang)}
        </p>
      </article>

      <!-- Card 4 -->
      <article class="rounded-2xl border border-neutral-200/70 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/40 p-6 backdrop-blur">
        <h3 class="leading-tight">
          <span class="block text-lg font-semibold text-neutral-900 dark:text-neutral-100">{card4.ko}</span>
          {card4.en && <span class="block mt-1 text-sm text-neutral-500">{card4.en}</span>}
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
          {t('values.card4Text', lang)}
        </p>
      </article>
    </div>
  </div>
</section>
