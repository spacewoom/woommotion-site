---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;

/**
 * "Korean | English" 형태면 2줄로 분리.
 * 파이프(|)가 없으면 1줄(ko만)로 표시.
 */
function splitTitle(raw: string) {
  const parts = (raw ?? '').split('|').map((s) => s.trim());
  const ko = parts[0] || raw;
  const en = parts[1] || '';
  return { ko, en };
}

const card1Title = splitTitle(t('values.card1Title', lang));
const card2Title = splitTitle(t('values.card2Title', lang));
const card3Title = splitTitle(t('values.card3Title', lang));
const card4Title = splitTitle(t('values.card4Title', lang));

/**
 * ✅ 여기 “경로만” 바꾸면 4개 카드 아이콘이 한 번에 바뀝니다.
 * public/services/video.svg  ->  /services/video.svg 로 접근
 */
const ICON_LIGHT = '/services/video.svg';
const ICON_DARK = '/services/video_white.svg';
---

<section id="services" class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {t('values.title', lang)}
      </h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl mx-auto">
        {t('values.subtitle', lang)}
      </p>
    </div>

    <!-- ✅ 원본 감성 유지 + 4카드 대응 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Card 1 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="mb-6 text-primary">
          <img
            src={ICON_SRC}
            alt={`${card1Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 dark:hidden"
          />
          <img
            src={ICON_SRC}
            alt={`${card1Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 hidden dark:block"
          />
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 transition-colors duration-300">
          <span class="block text-xl group-hover:text-primary leading-tight">{card1Title.ko}</span>
          {card1Title.en && (
            <span class="block mt-1 text-sm text-secondary/60 dark:text-white/60 group-hover:text-primary/80 leading-tight">
              {card1Title.en}
            </span>
          )}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card1Text', lang)}
        </p>
      </div>

      <!-- Card 2 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="mb-6 text-primary">
          <img
            src={ICON_SRC}
            alt={`${card2Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 dark:hidden"
          />
          <img
            src={ICON_SRC}
            alt={`${card2Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 hidden dark:block"
          />
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 transition-colors duration-300">
          <span class="block text-xl group-hover:text-primary leading-tight">{card2Title.ko}</span>
          {card2Title.en && (
            <span class="block mt-1 text-sm text-secondary/60 dark:text-white/60 group-hover:text-primary/80 leading-tight">
              {card2Title.en}
            </span>
          )}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card2Text', lang)}
        </p>
      </div>

      <!-- Card 3 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="mb-6 text-primary">
          <img
            src={ICON_SRC}
            alt={`${card3Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 dark:hidden"
          />
            <img
            src={ICON_SRC}
            alt={`${card3Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 hidden dark:block"
          />
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 transition-colors duration-300">
          <span class="block text-xl group-hover:text-primary leading-tight">{card3Title.ko}</span>
          {card3Title.en && (
            <span class="block mt-1 text-sm text-secondary/60 dark:text-white/60 group-hover:text-primary/80 leading-tight">
              {card3Title.en}
            </span>
          )}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card3Text', lang)}
        </p>
      </div>

      <!-- Card 4 -->
      <div
        class="group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <div class="mb-6 text-primary">
          <img
            src={ICON_SRC}
            alt={`${card4Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 dark:hidden"
          />
          <img
            src={ICON_SRC}
            alt={`${card4Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 hidden dark:block"
          />
        </div>

        <h3 class="font-heading text-secondary dark:text-white mb-3 transition-colors duration-300">
          <span class="block text-xl group-hover:text-primary leading-tight">{card4Title.ko}</span>
          {card4Title.en && (
            <span class="block mt-1 text-sm text-secondary/60 dark:text-white/60 group-hover:text-primary/80 leading-tight">
              {card4Title.en}
            </span>
          )}
        </h3>

        <p class="text-secondary/70 dark:text-white/70">
          {t('values.card4Text', lang)}
        </p>
      </div>

    </div>
  </div>
</section>
