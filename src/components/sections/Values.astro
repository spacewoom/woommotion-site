---
import { useTranslations } from "../../i18n/utils";

// ✅ 기존 파일에서 lang 받는 방식이 다르면, 그 방식 그대로 유지하세요.
// 아래는 템플릿에서 흔히 쓰는 형태입니다.
const lang = Astro.currentLocale ?? "en";
const t = useTranslations(lang);

// 제목을 "한글\nEnglish" 형태로 저장했을 때 안전하게 2줄로 분리
const splitTitle = (s: string) => {
  const [ko, en] = (s ?? "").split("\n");
  return { ko: ko ?? "", en: en ?? "" };
};
---

<section id="services" class="relative py-24">
  <div class="mx-auto max-w-container px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-4xl font-semibold tracking-tight md:text-5xl">
        {t("values.title")}
      </h2>

      <p class="mt-4 text-base leading-relaxed opacity-80 md:text-lg">
        {t("values.subtitle")}
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      <!-- Card 1 -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur">
        <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/5">
          <!-- icon -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 6h16v12H4z" />
            <path d="M7 9h10M7 12h10M7 15h7" />
          </svg>
        </div>

        {(() => {
          const title = splitTitle(t("values.card1Title"));
          return (
            <h3 class="text-xl font-semibold leading-snug">
              <span class="block text-[1.15rem] md:text-[1.2rem]">{title.ko}</span>
              <span class="mt-1 block text-sm font-normal opacity-75">{title.en}</span>
            </h3>
          );
        })()}

        <p class="mt-4 text-sm leading-relaxed opacity-80">
          {t("values.card1Text")}
        </p>
      </div>

      <!-- Card 2 -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur">
        <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/5">
          <!-- icon -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 7h16v10H4z" />
            <path d="M10 9l5 3-5 3V9z" />
          </svg>
        </div>

        {(() => {
          const title = splitTitle(t("values.card2Title"));
          return (
            <h3 class="text-xl font-semibold leading-snug">
              <span class="block text-[1.15rem] md:text-[1.2rem]">{title.ko}</span>
              <span class="mt-1 block text-sm font-normal opacity-75">{title.en}</span>
            </h3>
          );
        })()}

        <p class="mt-4 text-sm leading-relaxed opacity-80">
          {t("values.card2Text")}
        </p>
      </div>

      <!-- Card 3 -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur">
        <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/5">
          <!-- icon -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 3v18" />
            <path d="M4 7h16" />
            <path d="M6 11h12" />
            <path d="M8 15h8" />
          </svg>
        </div>

        {(() => {
          const title = splitTitle(t("values.card3Title"));
          return (
            <h3 class="text-xl font-semibold leading-snug">
              <span class="block text-[1.15rem] md:text-[1.2rem]">{title.ko}</span>
              <span class="mt-1 block text-sm font-normal opacity-75">{title.en}</span>
            </h3>
          );
        })()}

        <p class="mt-4 text-sm leading-relaxed opacity-80">
          {t("values.card3Text")}
        </p>
      </div>

      <!-- Card 4 -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur">
        <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/5">
          <!-- icon -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M8 7V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1" />
            <path d="M6 7h12v13H6z" />
            <path d="M9 11h6M9 14h6" />
          </svg>
        </div>

        {(() => {
          const title = splitTitle(t("values.card4Title"));
          return (
            <h3 class="text-xl font-semibold leading-snug">
              <span class="block text-[1.15rem] md:text-[1.2rem]">{title.ko}</span>
              <span class="mt-1 block text-sm font-normal opacity-75">{title.en}</span>
            </h3>
          );
        })()}

        <p class="mt-4 text-sm leading-relaxed opacity-80">
          {t("values.card4Text")}
        </p>
      </div>
    </div>
  </div>
</section>
