---
import { getLangFromUrl, useTranslations } from "../../utils/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// ✅ 아이콘 파일 1개만 유지 (public/services/video.svg)
const ICON_SRC = "/services/video.svg";

function splitTitle(title) {
  const parts = String(title).split("|").map((p) => p.trim());
  return {
    ko: parts[0] ?? "",
    en: parts[1] ?? "",
  };
}

const card1Title = splitTitle(t("values.card1Title", lang));
const card2Title = splitTitle(t("values.card2Title", lang));
const card3Title = splitTitle(t("values.card3Title", lang));
const card4Title = splitTitle(t("values.card4Title", lang));
---

<section id="services" class="relative overflow-hidden py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {t("values.title", lang)}
      </h2>
      <p class="mt-4 text-base leading-7 text-muted-foreground">
        {t("values.subtitle", lang)}
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-7xl grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Card 1 -->
      <div class="group relative rounded-2xl border border-border/60 bg-background/50 p-8 shadow-sm backdrop-blur transition hover:border-border">
        <div class="flex items-start gap-4">
          <!-- ✅ 다크모드에서만 반전: 한 파일로 라이트/다크 모두 대응 -->
          <img
            src={ICON_SRC}
            alt={`${card1Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 invert-0 dark:invert"
          />

          <div class="min-w-0">
            <h3 class="text-xl font-semibold leading-tight">
              <span class="block text-[1.05em]">{card1Title.ko}</span>
              <span class="block text-sm font-medium text-muted-foreground">
                {card1Title.en}
              </span>
            </h3>
            <p class="mt-3 leading-7 text-muted-foreground">
              {t("values.card1Text", lang)}
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="group relative rounded-2xl border border-border/60 bg-background/50 p-8 shadow-sm backdrop-blur transition hover:border-border">
        <div class="flex items-start gap-4">
          <img
            src={ICON_SRC}
            alt={`${card2Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 invert-0 dark:invert"
          />

          <div class="min-w-0">
            <h3 class="text-xl font-semibold leading-tight">
              <span class="block text-[1.05em]">{card2Title.ko}</span>
              <span class="block text-sm font-medium text-muted-foreground">
                {card2Title.en}
              </span>
            </h3>
            <p class="mt-3 leading-7 text-muted-foreground">
              {t("values.card2Text", lang)}
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="group relative rounded-2xl border border-border/60 bg-background/50 p-8 shadow-sm backdrop-blur transition hover:border-border">
        <div class="flex items-start gap-4">
          <img
            src={ICON_SRC}
            alt={`${card3Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 invert-0 dark:invert"
          />

          <div class="min-w-0">
            <h3 class="text-xl font-semibold leading-tight">
              <span class="block text-[1.05em]">{card3Title.ko}</span>
              <span class="block text-sm font-medium text-muted-foreground">
                {card3Title.en}
              </span>
            </h3>
            <p class="mt-3 leading-7 text-muted-foreground">
              {t("values.card3Text", lang)}
            </p>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="group relative rounded-2xl border border-border/60 bg-background/50 p-8 shadow-sm backdrop-blur transition hover:border-border">
        <div class="flex items-start gap-4">
          <img
            src={ICON_SRC}
            alt={`${card4Title.ko} icon`}
            width="32"
            height="32"
            loading="lazy"
            class="w-8 h-8 invert-0 dark:invert"
          />

          <div class="min-w-0">
            <h3 class="text-xl font-semibold leading-tight">
              <span class="block text-[1.05em]">{card4Title.ko}</span>
              <span class="block text-sm font-medium text-muted-foreground">
                {card4Title.en}
              </span>
            </h3>
            <p class="mt-3 leading-7 text-muted-foreground">
              {t("values.card4Text", lang)}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
