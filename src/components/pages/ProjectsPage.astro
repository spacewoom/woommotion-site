---
/** src/components/pages/ProjectsPage.astro */
import Button from '../ui/Buttons.astro';

const {
  title = 'Works',
  subtitle = '',
  topButtons = [],
  projects = [],
} = Astro.props;
---

<section class="py-16 md:py-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">

    <!-- 타이틀/서브타이틀 중앙 정렬 -->
    <div class="mb-10 text-center flex flex-col items-center">
      <h1 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {title}
      </h1>

      <!-- subtitle 영역: 반갈림 방지 + 한 줄 유지 옵션 -->
      <p class="text-body text-secondary/70 dark:text-white/70 max-w-6xl mx-auto lg:whitespace-nowrap">
        {subtitle}
      </p>
    </div>

    <!-- 상단 2개 버튼 -->
    {topButtons?.length ? (
      <div class="mb-10 flex flex-wrap justify-center gap-3">
        {topButtons.map((b) => (
          <Button text={b.text} href={b.href} variant={b.variant} />
        ))}
      </div>
    ) : null}

    <!-- 카드 그리드 -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {projects.map((project) => {
        const safeTitle = project?.title ?? 'Work';
        const tags = Array.isArray(project?.tags) ? project.tags : [];
        const info = project?.info ?? {};

        const youtubeUrl = info?.youtubeUrl ?? '';
        const canOpen = Boolean(youtubeUrl);

        return (
          <div class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
            <div class="relative overflow-hidden aspect-video">
              <button
                type="button"
                class={`w-full h-full text-left ${canOpen ? 'cursor-pointer' : 'cursor-default'}`}
                data-work-open={canOpen ? '' : undefined}
                data-youtube={youtubeUrl}
                data-title={safeTitle}
                aria-label={canOpen ? `${safeTitle} 재생` : safeTitle}
              >
                <img
                  src={project?.image ?? '/images/projects/card.jpg'}
                  alt={safeTitle}
                  class={`w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 ${canOpen ? '' : 'opacity-70'}`}
                  loading="lazy"
                />
              </button>

              <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="px-3 py-1 text-xs font-mono bg-white/90 dark:bg-neutral-dark/90 backdrop-blur-sm text-primary rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="p-6">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">
                {safeTitle}
              </h3>

              <p class="text-secondary/70 dark:text-white/70 mb-4">
                {project?.summary ?? ''}
              </p>

              <ul class="text-sm text-secondary/70 dark:text-white/70 space-y-1 mb-6">
                <li><span class="font-mono">작업연도</span> · {info?.year ?? '-'}</li>
                <li><span class="font-mono">러닝타임</span> · {info?.duration ?? '-'}</li>
                <li><span class="font-mono">역할</span> · {info?.role ?? '-'}</li>
              </ul>

              {youtubeUrl ? (
                <Button
                  text="YouTube에서 보기"
                  href={youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="outline"
                  size="sm"
                />
              ) : (
                <span class="text-sm text-secondary/50 dark:text-white/50">영상 링크 준비중</span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Modal -->
  <div
    id="workModal"
    class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/70 p-4"
    aria-hidden="true"
  >
    <div class="w-full max-w-5xl bg-white dark:bg-neutral-dark rounded-2xl overflow-hidden shadow-2xl">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 dark:border-gray-800">
        <p id="workModalTitle" class="font-heading text-secondary dark:text-white">
          Work
        </p>
        <button
          id="workModalClose"
          type="button"
          class="px-3 py-1 rounded-lg text-secondary/70 dark:text-white/70 hover:text-primary"
          aria-label="닫기"
        >
          ✕
        </button>
      </div>

      <div class="bg-black">
        <div class="aspect-video w-full">
          <iframe
            id="workModalFrame"
            class="w-full h-full"
            src=""
            title="Work video"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function toYouTubeEmbed(url) {
      if (!url) return '';
      try {
        const u = new URL(url);
        if (u.hostname.includes('youtu.be')) {
          const id = u.pathname.replace('/', '');
          return id ? `https://www.youtube.com/embed/${id}?autoplay=1&rel=0` : '';
        }
        const v = u.searchParams.get('v');
        if (v) return `https://www.youtube.com/embed/${v}?autoplay=1&rel=0`;
        if (u.pathname.includes('/embed/')) {
          return `${u.origin}${u.pathname}?autoplay=1&rel=0`;
        }
      } catch (e) {}
      return '';
    }

    function initWorkModal() {
      const modal = document.getElementById('workModal');
      const frame = document.getElementById('workModalFrame');
      const titleEl = document.getElementById('workModalTitle');
      const closeBtn = document.getElementById('workModalClose');

      if (!modal || !frame || !titleEl || !closeBtn) return;

      function openModal(youtubeUrl, title) {
        const embed = toYouTubeEmbed(youtubeUrl);
        if (!embed) return;
        titleEl.textContent = title || 'Work';
        frame.src = embed;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');
      }

      function closeModal() {
        frame.src = '';
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
      }

      document.querySelectorAll('[data-work-open]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const youtubeUrl = btn.getAttribute('data-youtube');
          const title = btn.getAttribute('data-title');
          openModal(youtubeUrl, title);
        });
      });

      closeBtn.addEventListener('click', closeModal);

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    }

    document.addEventListener('DOMContentLoaded', initWorkModal);
    document.addEventListener('astro:page-load', initWorkModal);
  </script>
</section>
