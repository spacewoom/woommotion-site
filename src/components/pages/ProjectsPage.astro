---
const {
  lang = "en",
  title = "Works",
  subtitle = "",
  topButtons = [],
  projects = [],
  pagination = null,
} = Astro.props;

/** ✅ 타이틀 끝의 2자리 숫자 제거: "메뉴보드 01" → "메뉴보드" */
function displayTitle(raw = "") {
  return String(raw ?? "").replace(/\s*\d{2}\s*$/u, "").trim();
}

/** ✅ 카드 summary: 공백 포함 65자 이내(말줄임표 포함) */
function summary65(raw = "") {
  const s = String(raw ?? "").replace(/\s+/g, " ").trim();
  if (s.length <= 65) return s;
  return s.slice(0, 64) + "…"; // 총 65자
}

/** ✅ 영상 링크/종류 추출 (works.js: media 우선, 없으면 info.youtubeUrl) */
function getVideo(work) {
  const src = work?.media?.src || work?.info?.youtubeUrl || "";
  const kind = work?.media?.kind || (src ? "youtube" : "");
  return { kind, src };
}

function getTags(work) {
  return Array.isArray(work?.tags) ? work.tags : [];
}

/** ✅ 페이지네이션 숫자 생성(최대 7개) */
function buildPageList(current, total, max = 7) {
  const pages = [];
  const half = Math.floor(max / 2);
  let start = Math.max(1, current - half);
  let end = Math.min(total, start + max - 1);
  start = Math.max(1, end - max + 1);
  for (let p = start; p <= end; p++) pages.push(p);
  return pages;
}

const pageList =
  pagination?.totalPages && pagination?.currentPage
    ? buildPageList(pagination.currentPage, pagination.totalPages, 7)
    : [];
---

<section class="pt-28 pb-16 md:pt-36 md:pb-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <!-- Title / Subtitle -->
    <div class="mb-10 text-center flex flex-col items-center" data-aos="fade-up">
      <h1 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {title}
      </h1>
      {subtitle ? (
        <p class="text-body text-secondary/70 dark:text-white/70 max-w-5xl mx-auto lg:whitespace-nowrap">
          {subtitle}
        </p>
      ) : null}
    </div>

    <!-- Top Buttons -->
    {topButtons?.length ? (
      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12" data-aos="fade-up">
        {topButtons.map((btn) => {
          const isPrimary = btn.variant === "primary";
          return (
            <a
              href={btn.href}
              class={
                isPrimary
                  ? "inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-6 bg-primary text-white hover:bg-primary/90"
                  : "inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-6 border border-primary text-primary hover:bg-primary/10 bg-transparent"
              }
            >
              {btn.text}
            </a>
          );
        })}
      </div>
    ) : null}

    <!-- Works Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {projects.map((work, index) => {
        const t = displayTitle(work?.title);
        const tags = getTags(work);
        const { kind, src } = getVideo(work);

        const thumb =
          work?.media?.poster ||
          work?.image ||
          "/images/projects/card.jpg";

        const hasVideo = Boolean(src);
        // ✅ 모달에 원문 summary를 안전하게 넘기기 위해 인코딩
        const summaryEncoded = encodeURIComponent(String(work?.summary ?? ""));

        return (
          <article
            class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={index * 40}
          >
            <!-- Thumbnail: 클릭 시 모달 오픈 -->
            <button
              type="button"
              class={"block relative w-full overflow-hidden aspect-video text-left " + (hasVideo ? "cursor-pointer" : "cursor-not-allowed")}
              data-open-video={hasVideo ? "true" : "false"}
              data-video-kind={kind}
              data-video-src={src}
              data-video-title={t}
              data-video-summary={summaryEncoded}
              aria-label={hasVideo ? `${t} 영상 재생` : `${t} (영상 링크 없음)`}
              disabled={!hasVideo}
            >
              <img
                src={thumb}
                alt={t}
                class={"w-full h-full object-cover transition-transform duration-500 " + (hasVideo ? "group-hover:scale-105" : "")}
                loading="lazy"
              />

              {hasVideo ? (
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-black/50 backdrop-blur-sm border border-white/20">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white">
                      <path d="M8 5v14l11-7z"></path>
                    </svg>
                  </span>
                </div>
              ) : (
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="px-3 py-1 text-xs font-mono bg-black/55 text-white/90 rounded-full border border-white/10">
                    영상 링크 없음
                  </span>
                </div>
              )}
            </button>

            <!-- Content -->
            <div class="p-6">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">
                {t}
              </h3>

              <!-- ✅ 카드 summary: 65자 이내 + 폰트 85% + 3줄 클램프 -->
              <p class="work-summary text-secondary/70 dark:text-white/70 mb-4">
                {summary65(work.summary)}
              </p>

              <!-- ✅ 정보 순서: 작업 연도 → 역할 -->
              <ul class="text-sm text-secondary/70 dark:text-white/70 space-y-1 mb-3">
                <li><span class="font-mono">작업 연도</span> · {work.info?.year}</li>
                <li><span class="font-mono">역할</span> · {work.info?.role}</li>
              </ul>

              <!-- ✅ 태그: 본문 영역 -->
              {tags.length ? (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <span class="px-3 py-1 text-xs font-mono bg-gray-100 dark:bg-white/10 text-secondary dark:text-white/80 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              ) : null}
            </div>
          </article>
        );
      })}
    </div>

    <!-- Pagination -->
    {pagination?.totalPages && pagination?.totalPages > 1 ? (
      <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination" data-aos="fade-up">
        {pagination.currentPage > 1 ? (
          <a
            href={`${pagination.basePath}?page=${pagination.currentPage - 1}`}
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-secondary/70 dark:text-white/70 hover:bg-gray-50 dark:hover:bg-white/5"
          >
            Prev
          </a>
        ) : (
          <span class="px-3 py-2 rounded-lg border border-gray-100 dark:border-gray-800 text-sm text-secondary/30 dark:text-white/30">
            Prev
          </span>
        )}

        {pageList.map((p) => {
          const isActive = p === pagination.currentPage;
          return (
            <a
              href={`${pagination.basePath}?page=${p}`}
              class={
                isActive
                  ? "px-3 py-2 rounded-lg bg-primary text-white text-sm"
                  : "px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-secondary/70 dark:text-white/70 hover:bg-gray-50 dark:hover:bg-white/5"
              }
              aria-current={isActive ? "page" : undefined}
            >
              {p}
            </a>
          );
        })}

        {pagination.currentPage < pagination.totalPages ? (
          <a
            href={`${pagination.basePath}?page=${pagination.currentPage + 1}`}
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-secondary/70 dark:text-white/70 hover:bg-gray-50 dark:hover:bg-white/5"
          >
            Next
          </a>
        ) : (
          <span class="px-3 py-2 rounded-lg border border-gray-100 dark:border-gray-800 text-sm text-secondary/30 dark:text-white/30">
            Next
          </span>
        )}
      </nav>
    ) : null}
  </div>

  <!-- ✅ Video Modal -->
  <div
    id="work-video-modal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 p-4"
    aria-hidden="true"
  >
    <div class="w-full max-w-4xl bg-black rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
      <div class="flex items-center justify-between px-4 py-3 bg-black/60">
        <p id="work-video-title" class="text-sm md:text-base text-white/90 truncate pr-3"></p>
        <button
          id="work-video-close"
          type="button"
          class="text-white/80 hover:text-white px-3 py-1 rounded-lg border border-white/10 hover:border-white/20"
          aria-label="Close video modal"
        >
          Close
        </button>
      </div>

      <!-- ✅ 모달에 summary 원문 전체 표시 -->
      <div class="px-4 pb-3 bg-black/60">
        <p
          id="work-video-summary"
          class="text-xs md:text-sm text-white/75 leading-relaxed max-h-36 overflow-auto pr-1"
        ></p>
      </div>

      <div class="relative w-full bg-black" style="padding-top:56.25%;">
        <div id="work-video-player" class="absolute inset-0"></div>
      </div>
    </div>
  </div>

  <!-- ✅ 카드 summary 스타일(85% + 3줄 클램프) -->
  <style is:inline>
    .work-summary{
      font-size:0.85em;
      display:-webkit-box;
      -webkit-line-clamp:3;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }
  </style>

  <!-- ✅ Modal Script: 버튼에 직접 바인딩 + DOMContentLoaded로 확실히 실행 -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("work-video-modal");
      const closeBtn = document.getElementById("work-video-close");
      const titleEl = document.getElementById("work-video-title");
      const summaryEl = document.getElementById("work-video-summary");
      const player = document.getElementById("work-video-player");

      if (!modal || !closeBtn || !titleEl || !summaryEl || !player) return;

      const safeDecode = (s = "") => {
        try { return decodeURIComponent(s); } catch { return String(s || ""); }
      };

      const getYoutubeId = (url = "") => {
        const m =
          url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/) ||
          url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/) ||
          url.match(/\/embed\/([a-zA-Z0-9_-]{6,})/) ||
          url.match(/\/shorts\/([a-zA-Z0-9_-]{6,})/);
        return m ? m[1] : "";
      };

      const openModal = (kind, src, title, summaryEncoded) => {
        titleEl.textContent = title || "";
        summaryEl.textContent = safeDecode(summaryEncoded || "");
        player.innerHTML = "";

        if (kind === "youtube") {
          const id = getYoutubeId(src);
          const embed = id
            ? `https://www.youtube.com/embed/${id}?autoplay=1&mute=0&controls=1&rel=0&playsinline=1`
            : src;

          const iframe = document.createElement("iframe");
          iframe.className = "w-full h-full";
          iframe.src = embed;
          iframe.title = title || "YouTube video";
          iframe.loading = "lazy";
          iframe.setAttribute("frameborder", "0");
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "true");
          player.appendChild(iframe);
        } else if (kind === "file") {
          const video = document.createElement("video");
          video.className = "w-full h-full";
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          player.appendChild(video);
        } else {
          // kind가 비어있어도 src가 유튜브면 유튜브로 취급
          const id = getYoutubeId(src);
          if (id) {
            const iframe = document.createElement("iframe");
            iframe.className = "w-full h-full";
            iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&mute=0&controls=1&rel=0&playsinline=1`;
            iframe.title = title || "YouTube video";
            iframe.loading = "lazy";
            iframe.setAttribute("frameborder", "0");
            iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
            iframe.setAttribute("allowfullscreen", "true");
            player.appendChild(iframe);
          }
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modal.setAttribute("aria-hidden", "true");
        player.innerHTML = "";
        summaryEl.textContent = "";
        document.body.style.overflow = "";
      };

      // ✅ 버튼에 직접 바인딩(closest 의존 제거)
      const buttons = document.querySelectorAll("button[data-open-video='true']");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const kind = btn.getAttribute("data-video-kind") || "";
          const src = btn.getAttribute("data-video-src") || "";
          const title = btn.getAttribute("data-video-title") || "";
          const summaryEncoded = btn.getAttribute("data-video-summary") || "";
          if (!src) return;
          openModal(kind, src, title, summaryEncoded);
        });
      });

      closeBtn.addEventListener("click", closeModal);

      // 모달 바깥 클릭 닫기
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      // ESC 닫기
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
      });
    });
  </script>
</section>
