---
const {
  lang = "en",
  title = "Works",
  subtitle = "",
  topButtons = [],
  projects = [],
  pagination = null,
} = Astro.props;

function displayTitle(raw = "") {
  return String(raw ?? "").replace(/\s*\d{2}\s*$/u, "").trim();
}

function getVideo(work) {
  const src = work?.media?.src || work?.info?.youtubeUrl || "";
  const kind = work?.media?.kind || (src ? "youtube" : "");
  return { kind, src };
}

function getTags(work) {
  return Array.isArray(work?.tags) ? work.tags : [];
}

function buildPageList(current, total, max = 7) {
  const pages = [];
  const half = Math.floor(max / 2);
  let start = Math.max(1, current - half);
  let end = Math.min(total, start + max - 1);
  start = Math.max(1, end - max + 1);
  for (let p = start; p <= end; p++) pages.push(p);
  return pages;
}

const pageList =
  pagination?.totalPages && pagination?.currentPage
    ? buildPageList(pagination.currentPage, pagination.totalPages, 7)
    : [];
---

<section class="pt-28 pb-16 md:pt-36 md:pb-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-10 text-center flex flex-col items-center" data-aos="fade-up">
      <h1 class="font-heading text-h2 text-secondary dark:text-white mb-4">
        {title}
      </h1>
      {subtitle ? (
        <p class="text-body text-secondary/70 dark:text-white/70 max-w-5xl mx-auto lg:whitespace-nowrap">
          {subtitle}
        </p>
      ) : null}
    </div>

    {topButtons?.length ? (
      <div class="flex flex-row gap-2 sm:gap-3 justify-center mb-12" data-aos="fade-up">
        {topButtons.map((btn) => {
          const isPrimary = btn.variant === "primary";
          return (
            <a
              href={btn.href}
              class={
                isPrimary
                  ? "inline-flex items-center justify-center rounded-lg font-medium w-1/2 sm:w-[220px] text-sm sm:text-base py-2 px-3 sm:px-6 bg-primary text-white hover:bg-primary/90 whitespace-nowrap"
                  : "inline-flex items-center justify-center rounded-lg font-medium w-1/2 sm:w-[220px] text-sm sm:text-base py-2 px-3 sm:px-6 border border-primary text-primary hover:bg-primary/10 bg-transparent whitespace-nowrap"
              }
            >
              {btn.text}
            </a>
          );
        })}
      </div>
    ) : null}

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {projects.map((work, index) => {
        const t = displayTitle(work?.title);
        const tags = getTags(work);
        const { kind, src } = getVideo(work);

        const thumb =
          work?.media?.poster ||
          work?.image ||
          "/images/projects/card.jpg";

        const hasVideo = Boolean(src);

        // ✅ 모달에 넘길 데이터(안전하게 인코딩)
        const summaryEncoded = encodeURIComponent(String(work?.summary ?? ""));
        const roleEncoded = encodeURIComponent(String(work?.info?.role ?? ""));
        const yearEncoded = encodeURIComponent(String(work?.info?.year ?? ""));
        const categoryEncoded = encodeURIComponent(String(work?.category ?? ""));
        const tagsEncoded = encodeURIComponent(JSON.stringify(tags));

        return (
          <article
            class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={index * 40}
          >
            <button
              type="button"
              class={"block relative w-full overflow-hidden aspect-video text-left " + (hasVideo ? "cursor-pointer" : "cursor-not-allowed")}
              data-open-video={hasVideo ? "true" : "false"}
              data-video-kind={kind}
              data-video-src={src}
              data-video-title={t}
              data-video-summary={summaryEncoded}
              data-video-role={roleEncoded}
              data-video-year={yearEncoded}
              data-video-category={categoryEncoded}
              data-video-tags={tagsEncoded}
              aria-label={hasVideo ? `${t} 작업 상세 열기` : `${t} (영상 링크 없음)`}
              disabled={!hasVideo}
            >
              <img
                src={thumb}
                alt={t}
                class={"w-full h-full object-cover transition-transform duration-500 " + (hasVideo ? "group-hover:scale-105" : "")}
                loading="lazy"
              />

              {hasVideo ? (
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-black/50 backdrop-blur-sm border border-white/20">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white">
                      <path d="M8 5v14l11-7z"></path>
                    </svg>
                  </span>
                </div>
              ) : (
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <span class="px-3 py-1 text-xs font-mono bg-black/55 text-white/90 rounded-full border border-white/10">
                    영상 링크 없음
                  </span>
                </div>
              )}
            </button>

            <div class="p-6">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">
                {t}
              </h3>

              <!-- ✅ summary: "2줄까지만" + 말줄임표 + 폰트 85% -->
              <p class="work-summary text-secondary/70 dark:text-white/70 mb-4">
                {work.summary}
              </p>

              <ul class="text-sm text-secondary/70 dark:text-white/70 space-y-1 mb-3">
                <li><span class="font-mono">작업 연도</span> · {work.info?.year}</li>
                <li><span class="font-mono">역할</span> · {work.info?.role}</li>
              </ul>

              {tags.length ? (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <span class="px-3 py-1 text-xs font-mono bg-gray-100 dark:bg-white/10 text-secondary dark:text-white/80 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              ) : null}
            </div>
          </article>
        );
      })}
    </div>

    {pagination?.totalPages && pagination?.totalPages > 1 ? (
      <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination" data-aos="fade-up">
        {pagination.currentPage > 1 ? (
          <a
            href={`${pagination.basePath}?page=${pagination.currentPage - 1}`}
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-secondary/70 dark:text-white/70 hover:bg-gray-50 dark:hover:bg-white/5"
          >
            Prev
          </a>
        ) : (
          <span class="px-3 py-2 rounded-lg border border-gray-100 dark:border-gray-800 text-sm text-secondary/30 dark:text-white/30">
            Prev
          </span>
        )}

        {pageList.map((p) => {
          const isActive = p === pagination.currentPage;
          return (
            <a
              href={`${pagination.basePath}?page=${p}`}
              class={
                isActive
                  ? "px-3 py-2 rounded-lg bg-primary text-white text-sm"
                  : "px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-secondary/70 dark:text-white/70 hover:bg-gray-50 dark:hover:bg-white/5"
              }
              aria-current={isActive ? "page" : undefined}
            >
              {p}
            </a>
          );
        })}

        {pagination.currentPage < pagination.totalPages ? (
          <a
            href={`${pagination.basePath}?page=${pagination.currentPage + 1}`}
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-sm text-secondary/70 dark:text-white/70 hover:bg-gray-50 dark:hover:bg-white/5"
          >
            Next
          </a>
        ) : (
          <span class="px-3 py-2 rounded-lg border border-gray-100 dark:border-gray-800 text-sm text-secondary/30 dark:text-white/30">
            Next
          </span>
        )}
      </nav>
    ) : null}
  </div>

  <!-- ✅ Work Detail Modal -->
  <div
    id="work-detail-modal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 p-3 md:p-6"
    aria-hidden="true"
  >
    <div class="w-full max-w-7xl max-h-[92vh] rounded-2xl overflow-hidden border border-white/10 bg-black shadow-2xl">
      <div class="flex items-start justify-between gap-3 px-4 py-3 bg-black/70 border-b border-white/10">
        <div class="min-w-0">
          <p id="modal-title" class="text-sm md:text-base text-white/95 font-medium truncate"></p>
          <div class="mt-1 flex flex-wrap gap-2 items-center">
            <span id="modal-category" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
            <span id="modal-year" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
            <span id="modal-role" class="text-[11px] md:text-xs font-mono px-2 py-1 rounded-full bg-white/10 text-white/80 border border-white/10"></span>
          </div>
        </div>

        <button
          id="modal-close"
          type="button"
          class="shrink-0 text-white/80 hover:text-white px-3 py-1 rounded-lg border border-white/10 hover:border-white/20"
          aria-label="Close modal"
        >
          Close
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-6">
        <div class="lg:col-span-4 bg-black">
          <div class="relative w-full" style="padding-top:56.25%;">
            <div id="modal-player" class="absolute inset-0"></div>
          </div>
        </div>

        <div class="lg:col-span-2 bg-black/60 border-t lg:border-t-0 lg:border-l border-white/10 overflow-auto max-h-[92vh]">
          <div class="p-4 md:p-5">
            <h4 class="text-white/90 text-sm md:text-base font-medium mb-2">작업 설명</h4>
            <p id="modal-summary" class="text-white/75 text-xs md:text-sm leading-relaxed whitespace-pre-line max-h-44 overflow-auto pr-1"></p>

            <div class="mt-5">
              <h4 class="text-white/90 text-sm md:text-base font-medium mb-2">태그</h4>
              <div id="modal-tags" class="flex flex-wrap gap-2"></div>
            </div>

            <div class="mt-6">
              <button
                id="modal-replay"
                type="button"
                class="w-full inline-flex items-center justify-center rounded-lg font-medium text-sm py-2.5 bg-white/10 text-white hover:bg-white/15 border border-white/10"
              >
                다시 재생
              </button>
            </div>

            <p class="mt-3 text-[11px] text-white/40">
              * ESC로 닫기 / 바깥 영역 클릭으로 닫기
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ summary 2줄 라인클램프 (글자수 제어 X) -->
  <style is:inline>
    .work-summary{
      font-size:0.85em;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("work-detail-modal");
      const closeBtn = document.getElementById("modal-close");
      const replayBtn = document.getElementById("modal-replay");

      const titleEl = document.getElementById("modal-title");
      const categoryEl = document.getElementById("modal-category");
      const yearEl = document.getElementById("modal-year");
      const roleEl = document.getElementById("modal-role");
      const summaryEl = document.getElementById("modal-summary");
      const tagsEl = document.getElementById("modal-tags");
      const player = document.getElementById("modal-player");

      if (!modal || !closeBtn || !replayBtn || !titleEl || !categoryEl || !yearEl || !roleEl || !summaryEl || !tagsEl || !player) return;

      let lastVideo = { kind: "", src: "", title: "" };

      const safeDecode = (s = "") => {
        try { return decodeURIComponent(s); } catch { return String(s || ""); }
      };

      const safeJson = (s = "[]") => {
        try { return JSON.parse(s); } catch { return []; }
      };

      const getYoutubeId = (url = "") => {
        const m =
          url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/) ||
          url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/) ||
          url.match(/\/embed\/([a-zA-Z0-9_-]{6,})/) ||
          url.match(/\/shorts\/([a-zA-Z0-9_-]{6,})/);
        return m ? m[1] : "";
      };

      const categoryLabel = (cat) => {
        const c = String(cat || "").toLowerCase();
        if (c === "agency") return "Category · Agency";
        if (c === "digital-signage") return "Category · Digital Signage";
        return c ? `Category · ${cat}` : "Category · -";
      };

      const renderTags = (tags) => {
        tagsEl.innerHTML = "";
        const list = Array.isArray(tags) ? tags : [];
        if (!list.length) {
          const empty = document.createElement("span");
          empty.className = "text-xs text-white/40";
          empty.textContent = "태그 없음";
          tagsEl.appendChild(empty);
          return;
        }

        list.forEach((tag) => {
          const chip = document.createElement("span");
          chip.className = "px-3 py-1 text-xs font-mono rounded-full bg-white/10 text-white/80 border border-white/10";
          chip.textContent = tag;
          tagsEl.appendChild(chip);
        });
      };

      const mountVideo = (kind, src, title) => {
        player.innerHTML = "";
        if (!src) return;

        const ytId = getYoutubeId(src);
        if (kind === "youtube" || ytId) {
          const id = ytId || getYoutubeId(src);
          const embed = id
            ? `https://www.youtube.com/embed/${id}?autoplay=1&mute=0&controls=1&rel=0&playsinline=1`
            : src;

          const iframe = document.createElement("iframe");
          iframe.className = "w-full h-full";
          iframe.src = embed;
          iframe.title = title || "YouTube video";
          iframe.loading = "lazy";
          iframe.setAttribute("frameborder", "0");
          iframe.setAttribute("allow", "autoplay; encrypted-media; picture-in-picture");
          iframe.setAttribute("allowfullscreen", "true");
          player.appendChild(iframe);
          return;
        }

        if (kind === "file") {
          const video = document.createElement("video");
          video.className = "w-full h-full";
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          player.appendChild(video);
          return;
        }
      };

      const openModal = (payload) => {
        const { kind="", src="", title="", summary="", role="", year="", category="", tags=[] } = payload || {};

        lastVideo = { kind, src, title };

        titleEl.textContent = title || "";
        categoryEl.textContent = categoryLabel(category);
        yearEl.textContent = `작업 연도 · ${year || "-"}`;
        roleEl.textContent = `역할 · ${role || "-"}`;
        summaryEl.textContent = summary || "";
        renderTags(tags);
        mountVideo(kind, src, title);

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modal.setAttribute("aria-hidden", "true");
        player.innerHTML = "";
        tagsEl.innerHTML = "";
        summaryEl.textContent = "";
        document.body.style.overflow = "";
      };

      const buttons = document.querySelectorAll("button[data-open-video='true']");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const kind = btn.getAttribute("data-video-kind") || "";
          const src = btn.getAttribute("data-video-src") || "";
          const title = btn.getAttribute("data-video-title") || "";

          const summary = safeDecode(btn.getAttribute("data-video-summary") || "");
          const role = safeDecode(btn.getAttribute("data-video-role") || "");
          const year = safeDecode(btn.getAttribute("data-video-year") || "");
          const category = safeDecode(btn.getAttribute("data-video-category") || "");

          const tagsRaw = safeDecode(btn.getAttribute("data-video-tags") || "[]");
          const tags = safeJson(tagsRaw);

          if (!src) return;
          openModal({ kind, src, title, summary, role, year, category, tags });
        });
      });

      closeBtn.addEventListener("click", closeModal);
      replayBtn.addEventListener("click", () => {
        if (!lastVideo?.src) return;
        mountVideo(lastVideo.kind, lastVideo.src, lastVideo.title);
      });

      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
      });
    });
  </script>
</section>
