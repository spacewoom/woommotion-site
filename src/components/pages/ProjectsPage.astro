---
import { works as allWorks } from "../../data/works.js";

const {
  lang = "en",
  title = "Works",
  subtitle = "흥미로운 연출, 명확한 정보 전달, 감각적인 모션으로 브랜드와 제품의 핵심 메시지를 설득력 있게 보여줍니다.",
  topButtons,
  projects,
  category = "all",
  pagination, // ✅ { basePath, currentPage, totalPages }
} = Astro.props;

const isDe = lang === "de";
const base = isDe ? "/de" : "";

const hrefAll = `${base}/projects`;

const defaultTopButtons = [
  { text: "Agency Outsourcing", href: `${base}/projects/agency`, variant: "outline" },
  { text: "Digital Signage Content", href: `${base}/projects/digital-signage`, variant: "outline" },
];

const buttons = topButtons ?? defaultTopButtons;

// pages에서 잘라서 넘기므로 projects 우선
const works =
  projects ??
  (category && category !== "all" ? allWorks.filter((w) => w.category === category) : allWorks);

function getYoutubeId(url = "") {
  const m =
    url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/) ||
    url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/) ||
    url.match(/\/embed\/([a-zA-Z0-9_-]{6,})/);
  return m ? m[1] : "";
}

function getYoutubeThumb(url = "") {
  const id = getYoutubeId(url);
  return id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : "";
}

function buttonClass(variant = "outline") {
  const baseClass =
    "inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-6 transition-colors";
  if (variant === "primary") return `${baseClass} bg-primary text-white hover:bg-primary/90`;
  return `${baseClass} border border-primary text-primary hover:bg-primary/10 bg-transparent`;
}

// ✅ 페이지 링크 생성 (?page=2)
function pageHref(basePath, pageNum) {
  if (!basePath) return "#";
  return pageNum <= 1 ? `${basePath}` : `${basePath}?page=${pageNum}`;
}

// ✅ 페이지 버튼 범위(너무 길어지면 1 ... 5 6 7 ... 20 형태)
function getPageItems(current, total) {
  if (!total || total <= 1) return [1];

  const items = [];
  const push = (v) => items.push(v);

  const window = 2; // current 주변 표시 폭
  const left = Math.max(1, current - window);
  const right = Math.min(total, current + window);

  push(1);

  if (left > 2) push("…");
  for (let i = left; i <= right; i++) {
    if (i !== 1 && i !== total) push(i);
  }
  if (right < total - 1) push("…");

  if (total !== 1) push(total);

  // 중복 제거(예: total 작을 때)
  return items.filter((v, idx, arr) => idx === 0 || v !== arr[idx - 1]);
}
---

<section class="pt-28 pb-16 md:pt-36 md:pb-24 bg-neutral-bg dark:bg-neutral-dark/60">
  <div class="max-w-container mx-auto px-6">

    <div class="mb-10 text-center flex flex-col items-center" data-aos="fade-up">
      <h1 class="font-heading text-h2 text-secondary dark:text-white mb-4">{title}</h1>
      <p class="text-body text-secondary/70 dark:text-white/70 max-w-5xl mx-auto lg:whitespace-nowrap">
        {subtitle}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12" data-aos="fade-up">
      {buttons.map((b) => (
        <a href={b.href} class={buttonClass(b.variant)}>{b.text}</a>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {works.map((work, index) => {
        const kind = work.media?.kind || (work.info?.youtubeUrl ? "youtube" : "");
        const src = work.media?.src || work.info?.youtubeUrl || "";
        const playable = Boolean(kind && src);

        const thumb =
          work.media?.poster ||
          (kind === "youtube" ? getYoutubeThumb(src) : "") ||
          work.image ||
          "/images/projects/card.jpg";

        const MediaEl = playable ? (
          <button
            type="button"
            class="relative w-full overflow-hidden aspect-video text-left"
            data-open-video
            data-video-kind={kind}
            data-video-src={src}
            data-video-title={work.title}
          >
            <img
              src={thumb}
              alt={work.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              {work.tags?.map((tag) => (
                <span class="px-3 py-1 text-xs font-mono bg-white/90 dark:bg-neutral-dark/90 backdrop-blur-sm text-primary rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-black/50 backdrop-blur-sm border border-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </span>
            </div>
          </button>
        ) : (
          <div class="relative w-full overflow-hidden aspect-video text-left">
            <img src={thumb} alt={work.title} class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              {work.tags?.map((tag) => (
                <span class="px-3 py-1 text-xs font-mono bg-white/90 dark:bg-neutral-dark/90 backdrop-blur-sm text-primary rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="px-4 py-2 rounded-full bg-black/50 text-white/90 text-sm border border-white/20">
                Coming soon
              </span>
            </div>
          </div>
        );

        return (
          <article
            class="md:col-span-4 group bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
            data-aos="fade-up"
            data-aos-delay={index * 40}
          >
            {MediaEl}
            <div class="p-6">
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">
                {work.title}
              </h3>
              <p class="text-secondary/70 dark:text-white/70 mb-4">{work.summary}</p>

              <ul class="text-sm text-secondary/70 dark:text-white/70 space-y-1">
                <li><span class="font-mono">작업연도</span> · {work.info?.year}</li>
                <li><span class="font-mono">역할</span> · {work.info?.role}</li>
              </ul>
            </div>
          </article>
        );
      })}
    </div>

    <!-- ✅ 페이지네이션 UI -->
    {pagination && pagination.totalPages > 1 ? (
      <nav class="mt-14 flex flex-col items-center gap-4" aria-label="Pagination" data-aos="fade-up">
        <div class="text-sm text-secondary/60 dark:text-white/60">
          Page {pagination.currentPage} / {pagination.totalPages}
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2">
          {/* Prev */}
          <a
            href={pageHref(pagination.basePath, Math.max(1, pagination.currentPage - 1))}
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-800 text-secondary dark:text-white/80 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
            aria-label="Previous page"
          >
            Prev
          </a>

          {getPageItems(pagination.currentPage, pagination.totalPages).map((p) =>
            p === "…" ? (
              <span class="px-3 py-2 text-secondary/50 dark:text-white/40">…</span>
            ) : (
              <a
                href={pageHref(pagination.basePath, p)}
                class={
                  p === pagination.currentPage
                    ? "px-3 py-2 rounded-lg bg-primary text-white border border-primary"
                    : "px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-800 text-secondary dark:text-white/80 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
                }
                aria-current={p === pagination.currentPage ? "page" : undefined}
              >
                {p}
              </a>
            )
          )}

          {/* Next */}
          <a
            href={pageHref(pagination.basePath, Math.min(pagination.totalPages, pagination.currentPage + 1))}
            class="px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-800 text-secondary dark:text-white/80 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
            aria-label="Next page"
          >
            Next
          </a>
        </div>
      </nav>
    ) : null}

    {/* category page only: back to all */}
    {category && category !== "all" ? (
      <div class="mt-10 text-center" data-aos="fade-up">
        <a href={hrefAll} class={buttonClass("outline")}>View all work</a>
      </div>
    ) : null}
  </div>

  <!-- Video Modal -->
  <div
    id="work-video-modal"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/70 p-4"
    aria-hidden="true"
  >
    <div class="w-full max-w-4xl bg-black rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
      <div class="flex items-center justify-between px-4 py-3 bg-black/60">
        <p id="work-video-title" class="text-sm md:text-base text-white/90 truncate pr-3"></p>
        <button
          id="work-video-close"
          type="button"
          class="text-white/80 hover:text-white px-3 py-1 rounded-lg border border-white/10 hover:border-white/20"
          aria-label="Close video modal"
        >
          Close
        </button>
      </div>

      <div class="relative w-full bg-black" style="padding-top:56.25%;">
        <div id="work-video-player" class="absolute inset-0"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const modal = document.getElementById("work-video-modal");
      const closeBtn = document.getElementById("work-video-close");
      const titleEl = document.getElementById("work-video-title");
      const player = document.getElementById("work-video-player");

      if (!modal || !closeBtn || !titleEl || !player) return;

      const getYoutubeId = (url = "") => {
        const m =
          url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/) ||
          url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/) ||
          url.match(/\/embed\/([a-zA-Z0-9_-]{6,})/);
        return m ? m[1] : "";
      };

      const openModal = (kind, src, title) => {
        titleEl.textContent = title || "";
        player.innerHTML = "";

        if (kind === "youtube") {
          const id = getYoutubeId(src);
