---
import { getLangFromUrl, useTranslations } from '././utils/i18n';
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Timeline items based on keys in i18n files
const timelineItems = ['item1', 'item2', 'item3', 'item4', 'item5'];

// Two-line titles (Korean first, English second)
const TITLE_LINES: Record<string, { ko: string; en: string }> = {
  item1: { ko: '클라이언트 요청 (결제)', en: 'Client Request (Payment)' },
  item2: { ko: '기획', en: 'Planning' },
  item3: { ko: '디자인', en: 'Design' },
  item4: { ko: '모션', en: 'Motion' },
  item5: { ko: '전달 & 수정', en: 'Delivery & Revisions' },
};

// Force left alignment for these titles only
const LEFT_TITLE = new Set(['item1', 'item3', 'item5']);
---

<section class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('timeline.title', lang)}</h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl">
        {t('timeline.subtitle', lang)}
      </p>
    </div>

    <div id="timeline-container" class="relative"> {/* Added id for GSAP trigger */}
      {/* Timeline line */}
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-secondary/10 dark:bg-white/10 md:-translate-x-1/2"></div>

      {timelineItems.map((item, idx) => (
        <div class="relative mb-12 md:mb-16" data-timeline-item>
          <div class={`flex flex-col md:flex-row md:items-center ${idx % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
            {/* Content */}
            <div class="md:w-1/2 md:text-right px-6 md:px-10 mb-6 md:mb-0">
              {/* Title: 2 lines (KO + EN), with selective left alignment */}
              <h3
                class={`font-heading text-xl md:text-2xl text-secondary dark:text-white mb-3 ${
                  LEFT_TITLE.has(item) ? 'text-left' : ''
                }`}
              >
                <span class="block">{TITLE_LINES[item]?.ko ?? t(`timeline.${item}Title`, lang)}</span>
                <span class="block text-sm md:text-base opacity-80">
                  {TITLE_LINES[item]?.en ?? ''}
                </span>
              </h3>

              {/*Subtitle/description: always left aligned */}
              <p class="text-secondary/70 dark:text-white/70 text-left">
                {t(`timeline.${item}Description`, lang)}
              </p>
            </div>

            {/* Center point */}
            <div class="absolute left-0 md:left-1/2 w-4 h-4 rounded-full bg-primary md:-translate-x-1/2 z-10"></div>

            {/* Year/Label */}
            <div class="md:w-1/2 px-6 md:px-10">
              <div class={`inline-block px-4 py-2 rounded-full bg-primary/10 dark:bg-primary/20 text-primary font-medium ${idx % 2 === 0 ? 'md:ml-10' : 'md:mr-10 md:float-right'}`}>
                {t(`timeline.${item}Label`, lang)}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Initialize animation only on client-side
  if (typeof window !== 'undefined') {
    // Wait for page to load
    window.addEventListener('load', () => {
      // Select all timeline items
      const timelineItems = document.querySelectorAll('[data-timeline-item]');
      
      // Create a staggered animation for timeline items
      gsap.fromTo(
        timelineItems,
        { 
          opacity: 0,
          y: 30
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.2,
          ease: "power2.out",
          scrollTrigger: {
            trigger: "#timeline-container",
            start: "top 70%",
            end: "bottom 20%",
            toggleActions: "play none none none"
          }
        }
      );
      
      // Animate the timeline line
      gsap.fromTo(
        "#timeline-container > div:first-child",
        { 
          scaleY: 0,
          transformOrigin: "top"
        },
        {
          scaleY: 1,
          duration: 1.5,
          ease: "power2.out",
          scrollTrigger: {
            trigger: "#timeline-container",
            start: "top 80%",
            end: "top 30%",
            toggleActions: "play none none none"
          }
        }
      );
    });
  }
</script>
