---
import Layout from "../../layouts/Layout.astro";
import ProjectsPage from "../../components/pages/ProjectsPage.astro";
import { buildGrid, paginateWorks } from "../../data/works.js";

const lang = Astro.currentLocale ?? "en";
const prefix = lang === "de" ? "/de" : "";

const topButtons = [
  { text: "전체 작업 보기", href: `${prefix}/projects`, variant: "outline" },
  { text: "디지털 사이니지", href: `${prefix}/projects/digital-signage`, variant: "primary" },
];

const pageParam = Astro.url.searchParams.get("page");
const page = pageParam ? Number(pageParam) : 1;

const perPage = 30;

const allProjects = buildGrid({ category: "agency" });
const { items, totalPages, currentPage } = paginateWorks(allProjects, page, perPage);

const basePath = `${prefix}/projects/agency`;
---

<Layout title="Agency Outsourcing" description="Agency Outsourcing works" lang={lang}>
  <ProjectsPage
    lang={lang}
    title="Agency Outsourcing"
    subtitle="에이전시/스튜디오 협업용 작업들을 모아볼 수 있습니다."
    topButtons={topButtons}
    projects={items}
    category="agency"
    pagination={{ basePath, currentPage, totalPages }}
  />
</Layout>
