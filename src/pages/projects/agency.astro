---
import Layout from "../../layouts/Layout.astro";
import ProjectsPage from "../../components/pages/ProjectsPage.astro";
import { buildGrid } from "../../data/works.js";

const lang = Astro.currentLocale ?? "en";
const prefix = lang === "de" ? "/de" : "";

const topButtons = [
  { text: "Agency Outsourcing", href: `${prefix}/projects/agency`, variant: "primary" },
  { text: "Digital Signage Content", href: `${prefix}/projects/digital-signage`, variant: "outline" },
];

const projects = buildGrid({ category: "agency", targetCount: 30 });
---

<Layout title="Agency Outsourcing" description="Agency Outsourcing works" lang={lang}>
  <ProjectsPage
    lang={lang}
    title="Agency Outsourcing"
    subtitle="에이전시/스튜디오 협업용 작업들을 모아볼 수 있습니다."
    topButtons={topButtons}
    projects={projects}
    category="agency"
  />
</Layout>
