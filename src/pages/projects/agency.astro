---
import Layout from '../../layouts/Layout.astro';
import ProjectsPage from '../../components/pages/ProjectsPage.astro';
import { works, makePlaceholders } from '../../data/works';

const lang = Astro.currentLocale;

const topButtons = [
  { text: 'Agency Outsourcing', href: '/projects/agency', variant: 'primary' },
  { text: 'Digital Signage Content', href: '/projects/digital-signage', variant: 'outline' },
];

const filtered = works.filter(w => w.category === 'agency');
const projects = [...filtered, ...makePlaceholders(30 - filtered.length)];
---

<Layout title="Works | Agency" description="Agency works" lang={lang}>
  <main>
    <ProjectsPage
      title="Agency Outsourcing"
      subtitle="의뢰 기반 제작 작업을 모아볼 수 있습니다."
      topButtons={topButtons}
      projects={projects}
    />
  </main>
</Layout>
