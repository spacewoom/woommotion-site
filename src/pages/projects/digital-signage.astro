---
import Layout from "../../layouts/Layout.astro";
import ProjectsPage from "../../components/pages/ProjectsPage.astro";
import { buildGrid, paginateWorks } from "../../data/works.js";

const lang = Astro.currentLocale ?? "en";
const prefix = lang === "de" ? "/de" : "";

const topButtons = [
  { text: "전체 작업 보기", href: `${prefix}/projects`, variant: "outline" },
  { text: "에이전시 아웃소싱", href: `${prefix}/projects/agency`, variant: "primary" },
];

const pageParam = Astro.url.searchParams.get("page");
const page = pageParam ? Number(pageParam) : 1;

const perPage = 30;

const allProjects = buildGrid({ category: "digital-signage" });
const { items, totalPages, currentPage } = paginateWorks(allProjects, page, perPage);

const basePath = `${prefix}/projects/digital-signage`;
---

<Layout title="Digital Signage Content" description="Digital signage works" lang={lang}>
  <ProjectsPage
    lang={lang}
    title="Digital Signage Content"
    subtitle="DID/매장 사이니지 환경에 최적화된 콘텐츠 작업들을 모아볼 수 있습니다."
    topButtons={topButtons}
    projects={items}
    category="digital-signage"
    pagination={{ basePath, currentPage, totalPages }}
  />
</Layout>
