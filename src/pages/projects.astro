---
// src/pages/projects.astro
import Layout from "../layouts/Layout.astro";
import ProjectsPage from "../components/pages/ProjectsPage.astro";
import { buildGrid } from "../data/works.js";

const lang = Astro.currentLocale ?? "en";
const prefix = lang === "de" ? "/de" : "";

const topButtons = [
  { text: "Agency Outsourcing", href: `${prefix}/projects/agency`, variant: "outline" },
  { text: "Digital Signage Content", href: `${prefix}/projects/digital-signage`, variant: "outline" },
];

// ✅ 업로드된 작업 개수만큼 자동 반환
const projects = buildGrid({ category: "all" });
---

<Layout title="Works" description="View all work" lang={lang}>
  <main>
    <ProjectsPage
      lang={lang}
      title="Works"
      subtitle="지금까지 제작한 작업을 한 페이지에서 확인할 수 있습니다."
      topButtons={topButtons}
      projects={projects}
      category="all"
    />
  </main>
</Layout>
