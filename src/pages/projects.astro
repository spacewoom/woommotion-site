---
// src/pages/projects.astro
import Layout from "../layouts/Layout.astro";
import ProjectsPage from "../components/pages/ProjectsPage.astro";
import { buildGrid, paginateWorks } from "../data/works.js";

const lang = Astro.currentLocale ?? "en";
const prefix = lang === "de" ? "/de" : "";

const topButtons = [
  { text: "Agency Outsourcing", href: `${prefix}/projects/agency`, variant: "outline" },
  { text: "Digital Signage Content", href: `${prefix}/projects/digital-signage`, variant: "outline" },
];

// ✅ page 쿼리 파라미터 (?page=2)
const pageParam = Astro.url.searchParams.get("page");
const page = pageParam ? Number(pageParam) : 1;

const perPage = 30;

// ✅ 정렬된 전체 작업 리스트
const allProjects = buildGrid({ category: "all" });

// ✅ 페이지네이션 적용
const { items, totalPages, currentPage } = paginateWorks(allProjects, page, perPage);

// ✅ 페이지네이션 링크의 basePath (독일어 prefix 반영)
const basePath = `${prefix}/projects`;
---

<Layout title="Works" description="View all work" lang={lang}>
  <main>
    <ProjectsPage
      lang={lang}
      title="Works"
      subtitle="지금까지 제작한 작업을 한 페이지에서 확인할 수 있습니다."
      topButtons={topButtons}
      projects={items}
      category="all"
      pagination={{ basePath, currentPage, totalPages }}
    />
  </main>
</Layout>
