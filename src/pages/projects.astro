---
// src/pages/projects.astro
import Layout from '../layouts/Layout.astro';
import ProjectsPage from '../components/pages/ProjectsPage.astro';
import { works, makePlaceholders } from '../data/works';

const lang = Astro.currentLocale;

// 상단 2개 버튼
const topButtons = [
  { text: 'Agency Outsourcing', href: '/projects/agency', variant: 'primary' },
  { text: 'Digital Signage Content', href: '/projects/digital-signage', variant: 'outline' },
];

// 카드 30개 유지(부족하면 placeholder로 채움)
const base = works;
const placeholders = makePlaceholders(30 - base.length);
const projects = [...base, ...placeholders];
---

<Layout title="Works" description="View all work" lang={lang}>
  <main>
    <ProjectsPage
      title="Works"
      subtitle="지금까지 제작한 작업을 한 페이지에서 확인할 수 있습니다."
      topButtons={topButtons}
      projects={projects}
    />
  </main>
</Layout>
